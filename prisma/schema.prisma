/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Buchfuehrungen {
  rowid        Int       @id @default(autoincrement())
  ID           Int @unique
  Bezeichnung  String?
  Anfangsdatum DateTime?
  Enddatum     DateTime?
  Objekt       Int?
  Bemerkungen  String?
  Team         String?

  @@map("Buchfuehrungen")
  rel_Buchungen_Buchfuehrung Buchungen[] @relation("rel_Buchfuehrungen_Buchungen_Buchfuehrung")
  rel_Objekte_Objekt Objekte? @relation("rel_Objekte_Buchfuehrungen_Objekt", fields: [Objekt], references: [ID])

}

