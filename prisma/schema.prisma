generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Abrechnungen {
  ID                   Int       @id @default(autoincrement())
  Bezeichnung          String?
  Von                  DateTime?
  Bis                  DateTime?
  Quadratmeter         Decimal?
  Einheiten            Int?
  Miteigentumsanteile  Decimal?
  Einheiten2           Int?
  Quadratmeter2        Decimal?
  Wasserverbrauch      Decimal?
  Muellverbrauch       Decimal?
  Personen             Decimal?
  Objekt               Int?
  Art                  String?
  Waermemengenzaehler  Decimal?
  Heizwert             Decimal?
  Waermeverbrauch      Decimal?
  Grundkostenanteil    Int?
  Buchfuehrung         Int?
  Anmerkungen          String?
  Miteigentumsanteile2 Decimal?
  Quadratmeter3        Decimal?
  Team                 String?
  Miteigentumsanteile3 Decimal?
  Einheiten3           Int?
  Stromverbrauch       Decimal?
  Erledigt             Int?
  rel_Abrechnungskonten_Abrechnung Abrechnungskonten[] @relation("rel_Abrechnungen_Abrechnungskonten_Abrechnung")
  rel_Kosten_Abrechnung Kosten[] @relation("rel_Abrechnungen_Kosten_Abrechnung")
  rel_Kontobuch_Abrechnung Kontobuch[] @relation("rel_Abrechnungen_Kontobuch_Abrechnung")
  rel_Objekte_Objekt Objekte? @relation("rel_Objekte_Abrechnungen_Objekt", fields: [Objekt], references: [ID])

}

model Abrechnungskonten {
  ID                  Int       @id @default(autoincrement())
  Bezeichnung         String?
  Von                 DateTime?
  Bis                 DateTime?
  Quadratmeter        Decimal?
  Anschrift           String?
  Abrechnung          Int?
  Miteigentumsanteil  Decimal?
  Einheiten2          Int?
  Quadratmeter2       Decimal?
  Wasserverbrauch     Decimal?
  Muellverbrauch      Decimal?
  Personen            Decimal?
  Einheit             Int?
  Adresse             Int?
  Objekt              Int?
  Warmwasserverbrauch Decimal?
  Waermeverbrauch     Decimal?
  Anmerkungen         String?
  Anpassung           Decimal?
  Neuemiete           Decimal?
  Miteigentumsanteil2 Decimal?
  Zaehlerinfo         String?
  MwstSatz            Decimal?
  Quadratmeter3       Decimal?
  Team                String?
  Miteigentumsanteil3 Decimal?
  Einheiten3          Int?
  Stromverbrauch      Decimal?
  Erledigt            Int?
  rel_Abrechnungen_Abrechnung Abrechnungen? @relation("rel_Abrechnungen_Abrechnungskonten_Abrechnung", fields: [Abrechnung], references: [ID])
  rel_Kosten_Abrechnungskonto Kosten[] @relation("rel_Abrechnungskonten_Kosten_Abrechnungskonto")
  rel_Kosten_ID Kosten[] @relation("rel_Abrechnungskonten_Kosten_ID")
  rel_Personen_Abrechnungskonto Personen[] @relation("rel_Abrechnungskonten_Personen_Abrechnungskonto")
  rel_Kontobuch_Abrechnungskonto Kontobuch[] @relation("rel_Abrechnungskonten_Kontobuch_Abrechnungskonto")
  rel_Adressen_Adresse Adressen? @relation("rel_Adressen_Abrechnungskonten_Adresse", fields: [Adresse], references: [ID])
  rel_Einheiten_Einheit Einheiten? @relation("rel_Einheiten_Abrechnungskonten_Einheit", fields: [Einheit], references: [ID])

}

