  "Personenschnitt": {
   "op": "sqlScalar",
   "table": "Abrechnungen",
   "sql": "select sum(round(Anzahl * (datediff(Personen.Bis,Personen.Von)+1) / 365,1)) as Durchschnitt from Personen RIGHT OUTER JOIN `Abrechnungskonten` ON `Abrechnungskonten`.`ID` = `Personen`.`Abrechnungskonto` where Abrechnungskonten.Abrechnung=?",
   "binds": [
    {
     "from": "record",
     "name": "ID"
    }
   ]
  },
  "Info1": {
   "op": "sqlScalar",
   "table": "Abrechnungskonten",
   "sql": "SELECT\nAbrechnungskonten.`Bezeichnung`,\n@tage := datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1 AS `Tage`,\n@konto:= Abrechnungskonten.ID as Konto,\n@anteilbrutto:=(select\nsum(CASE\nWHEN Kosten.Umlageart = 'Quadratmeter'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Quadratmeter * @tage) / (Abrechnungen.Quadratmeter * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Einheiten'\nTHEN ROUND((Kosten.Betrag * (1 * @tage) / (Abrechnungen.Einheiten * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Quadratmeter 2'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Quadratmeter2 * @tage) / (Abrechnungen.Quadratmeter2 * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Einheiten 2'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Einheiten2 * @tage) / (Abrechnungen.Einheiten2 * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Einheiten 3'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Einheiten3 * @tage) / (Abrechnungen.Einheiten3 * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Wasserverbrauch'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Wasserverbrauch) / (Abrechnungen.Wasserverbrauch / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Müllverbrauch'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Muellverbrauch * @tage) / (Abrechnungen.Muellverbrauch * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Miteigentumsanteile'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Miteigentumsanteil * @tage) / (Abrechnungen.Miteigentumsanteile * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Miteigentumsanteile 2'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Miteigentumsanteil2 * @tage) / (Abrechnungen.Miteigentumsanteile2 * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Miteigentumsanteile 3'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Miteigentumsanteil3 * @tage) / (Abrechnungen.Miteigentumsanteile3 * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Umlageart = 'Personen'\nTHEN ROUND((Kosten.Betrag * (Abrechnungskonten.Personen * @tage) / (Abrechnungen.Personen * (datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)  / 100) / 100), 2)\nWHEN Kosten.Art = 'Direkte Kosten' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID\nTHEN Kosten.Betrag * 1\nWHEN Kosten.Art = 'Vorauszahlungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID\nTHEN Kosten.Betrag * - 1\nWHEN Kosten.Art = 'Rücklage Forderungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID\nTHEN Kosten.Betrag * 1\nWHEN Kosten.Art = 'Rücklage Zahlungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID\nTHEN Kosten.Betrag * - 1\nEND) as Anteil\nFROM `Kosten`\nLEFT OUTER JOIN `Abrechnungen` ON `Kosten`.`Abrechnung` = `Abrechnungen`.`ID`\nINNER JOIN `Abrechnungskonten` ON `Abrechnungen`.`ID` = `Abrechnungskonten`.`Abrechnung`\nWHERE (`Kosten`.`Art` <>'Haushaltsnahe Dienstleistungen') AND (`Abrechnungen`.`Art` ='Betriebskostenabrechnung') and Abrechnungskonten.ID=@konto)\nas Anteilbrutto,\nround(@anteilbrutto/12,2) as Anpassung\nFROM `Abrechnungskonten`\nwhere Abrechnungskonten.ID=? ORDER BY `Abrechnungskonten`.`Bezeichnung`",
   "binds": [
    {
     "from": "local",
     "name": "konto"
    }
   ]
  },
