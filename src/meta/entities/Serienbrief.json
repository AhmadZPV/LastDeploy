{
 "entity": "Serienbrief",
 "shortName": "Serienbrief",
 "baseTable": "Abrechnungskonten",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "",
  "sqlHead": "SELECT Abrechnungskonten.ID,  Abrechnungskonten.Bezeichnung AS Abrechnungskonto,  Abrechnungskonten.Von,  Abrechnungskonten.Bis,  Abrechnungskonten.Quadratmeter,  Abrechnungskonten.Anschrift AS Anschrift,  Abrechnungskonten.Abrechnung,  Abrechnungskonten.Miteigentumsanteil,  Abrechnungskonten.Einheiten2,  Abrechnungskonten.Quadratmeter2,  Abrechnungskonten.Wasserverbrauch,  Abrechnungskonten.Muellverbrauch,  Abrechnungskonten.Personen,  Einheiten.Bezeichnung AS Einheit,  Abrechnungskonten.Adresse AS Empfaenger,  Objekte.Bezeichnung AS Objekt,  Abrechnungskonten.Warmwasserverbrauch,  Abrechnungskonten.Waermeverbrauch,  Abrechnungskonten.Anpassung,  Abrechnungskonten.Neuemiete,  Abrechnungskonten.Miteigentumsanteil2,  Abrechnungskonten.MwstSatz,  Abrechnungskonten.Quadratmeter3,  Abrechnungen.Von AS `Abrechnung Von`,  Abrechnungen.Bis AS `Abrechnung Bis`,  Abrechnungen.Quadratmeter AS `Abrechnung Quadratmeter`,  Abrechnungen.Einheiten,  Abrechnungen.Miteigentumsanteile,  Abrechnungen.Einheiten2 AS `Abrechnung Einheiten2`,  Abrechnungen.Quadratmeter2 AS `Abrechnung Quadratmeter2`,  Abrechnungen.Wasserverbrauch AS `Abrechnung Wasserverbrauch`,  Abrechnungen.Muellverbrauch AS `Abrechnung Muellverbrauch`,  Abrechnungen.Personen AS `Abrechnung Personen`,  Abrechnungen.Art,  Abrechnungen.Quadratmeter3 AS `Abrechnung Quadratmeter3`,  Einstellungen.Absenderzeile AS Absender,  Einstellungen.Ort,  Einstellungen.Grussformel AS Gruss,  Einstellungen.Fussbereich AS Fuss,  Einstellungen.LogoLink,  Einstellungen.Serienbrief,  Adressen.Vorname,  Adressen.Nachname,  Adressen.Anrede AS Anrede,  Einheiten.Kaltmiete,  Einheiten.Nebenkosten,  Einheiten.Heizkosten,  Abrechnungskonten.Team",
  "sqlFrom": "FROM Abrechnungskonten  INNER JOIN Abrechnungen ON Abrechnungskonten.Abrechnung = Abrechnungen.ID  LEFT OUTER JOIN Adressen ON Abrechnungskonten.Adresse = Adressen.ID  INNER JOIN Objekte ON Abrechnungskonten.Objekt = Objekte.ID  LEFT OUTER JOIN Einheiten ON Abrechnungskonten.Einheit = Einheiten.ID  , Einstellungen",
  "sqlWhere": "",
  "sqlTail": ""
 },
