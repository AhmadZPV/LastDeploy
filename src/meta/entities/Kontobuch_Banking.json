{
  "entity": "Kontobuch_Banking",
  "shortName": "Kontobuch_Banking",
  "baseTable": "Kontobuch",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Datum DESC",
    "sqlHead": "SELECT ID,  Datum,  Betrag,  Betreff,  Kategorie,  Art,  Team,  Bank,  BIC,  IBAN,  Kontoinhaber,  Replace(CONCAT('bank://singlepayment?name=',Kontoinhaber,'&account=',IBAN,'&BNC=',BIC,'&amount=',Betrag,'&reason=',Betreff), ' ', '+') AS Bezahlcode,  concat(\"BCD\", '\\n', \"001\", '\\n', \"1\", '\\n', \"SCT\", '\\n', cast(BIC as Char(11)), '\\n', cast(Kontoinhaber as char(70)), '\\n', cast(IBAN as char(34)), '\\n', cast(concat(\"EUR\",Betrag) as char(12)), '\\n', \"    \", '\\n', space(35), '\\n', cast(Betreff as char(140))) AS girocode",
    "sqlFrom": "FROM Kontobuch",
    "sqlWhere": "",
    "sqlTail": ""
  },
