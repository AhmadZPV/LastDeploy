{
  "entity": "Buchungsbericht_Mwst",
  "shortName": "Buchungsbericht_Mwst",
  "baseTable": "Kontobuch",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Datum",
    "sqlHead": "SELECT ID,  Datum,  @Betrag := if(Art=\"Einnahme\", `Betrag`, -1*Betrag) AS Betrag,  Betreff,  Kategorie,  Art,  Abrechnung,  if(`Abrechnungskonto` is Null, \"-\", Abrechnungskonto) AS Abrechnungskonto,  Belegnummer,  Team,  if (MwstSatz is Null, 0, MwstSatz) as MwstSatz,  @Netto := @Betrag / (1+(MwstSatz/100)) as Netto,  @Brutto := @Betrag-@Netto as Steuer",
    "sqlFrom": "FROM Kontobuch",
    "sqlWhere": "",
    "sqlTail": ""
  },
