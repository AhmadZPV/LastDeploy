{
  "entity": "Buchungsbericht_Objekte",
  "shortName": "Buchungsbericht_Objekte",
  "baseTable": "Kontobuch",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Kontobuch.Datum",
    "sqlHead": "SELECT Kontobuch.ID,  Kontobuch.Datum,  if(Kontobuch.Art=\"Einnahme\", `Betrag`, -1*Betrag) AS Betrag,  Kontobuch.Betreff,  Kontobuch.Kategorie,  Kontobuch.Art AS Buchungsart,  Kontobuch.Miete,  Kontobuch.Nebenkosten,  Kontobuch.Heizkosten,  Kontobuch.Garagenmiete,  Kontobuch.Abrechnung,  if(`Abrechnungskonto` is Null, \"-\", Abrechnungskonto) AS Abrechnungskonto,  Kontobuch.Belegnummer,  Kontobuch.Team,  Objekte.Bezeichnung as Objekt,  Einheiten.Bezeichnung AS Einheit",
    "sqlFrom": "FROM Kontobuch  LEFT OUTER JOIN Abrechnungen ON Kontobuch.Abrechnung = Abrechnungen.ID  LEFT OUTER JOIN Objekte ON Abrechnungen.Objekt = Objekte.ID  LEFT OUTER JOIN Abrechnungskonten ON Kontobuch.Abrechnungskonto = Abrechnungskonten.ID  LEFT OUTER JOIN Einheiten ON Abrechnungskonten.Einheit = Einheiten.ID",
    "sqlWhere": "",
    "sqlTail": ""
  },
