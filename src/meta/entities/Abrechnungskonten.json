{
 "entity": "Abrechnungskonten",
 "shortName": "Abrechnungskonten",
 "baseTable": "Abrechnungskonten",
 "isVirtual": false,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY Abrechnungskonten.Bezeichnung",
  "sqlHead": "Select Abrechnungskonten.ID,  Abrechnungskonten.Bezeichnung,  Abrechnungskonten.Von,  Abrechnungskonten.Bis,  @Tage := datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1 AS Tage,  Abrechnungskonten.Quadratmeter,  Abrechnungskonten.Quadratmeter*@Tage AS Quadratmetertage,  Abrechnungskonten.Anschrift,  Abrechnungskonten.Abrechnung,  Abrechnungen.Von AS Abrechnung_Von,  Abrechnungen.Bis AS Abrechnung_Bis,  Abrechnungen.Quadratmeter AS Gesamt_Quadratmeter,  Abrechnungen.Einheiten AS Gesamt_Einheiten,  (Abrechnungskonten.Quadratmeter*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Quadratmeter*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS QM_Anteil,  (1*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Einheiten*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS Einheiten_Anteil,  (Abrechnungskonten.Quadratmeter2*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Quadratmeter2*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS QM_Anteil2,  (Abrechnungskonten.Quadratmeter3*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Quadratmeter3*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS QM_Anteil3,  (Abrechnungskonten.Einheiten2*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Einheiten2*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS Einheiten_Anteil2,  (Abrechnungskonten.Einheiten3*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Einheiten3*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS Einheiten_Anteil3,  (Abrechnungskonten.Miteigentumsanteil*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Miteigentumsanteile*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS MEA_Anteil,  (Abrechnungskonten.Miteigentumsanteil2*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Miteigentumsanteile2*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS MEA_Anteil2,  (Abrechnungskonten.Miteigentumsanteil3*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Miteigentumsanteile3*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS MEA_Anteil3,  (Abrechnungskonten.Wasserverbrauch)/(Abrechnungen.Wasserverbrauch/100) AS Wasserverbrauch_Anteil,  (Abrechnungskonten.Muellverbrauch*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Muellverbrauch*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS Muellverbrauch_Anteil,  (Abrechnungskonten.Personen*(datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1))/(Abrechnungen.Personen*(datediff(Abrechnungen.Bis,Abrechnungen.Von)+1)/100) AS Personen_Anteil,  (Abrechnungskonten.Warmwasserverbrauch)/(Abrechnungen.Waermemengenzaehler/100) AS Warmwasser_Anteil,  (Abrechnungskonten.Waermeverbrauch)/(Abrechnungen.Waermeverbrauch/100) AS Heizung_Anteil,  Abrechnungskonten.Miteigentumsanteil,  Abrechnungskonten.Einheiten2,  Abrechnungskonten.Einheiten3,  Abrechnungskonten.Quadratmeter2,  Abrechnungskonten.Quadratmeter3,  Abrechnungskonten.Wasserverbrauch,  Abrechnungskonten.Muellverbrauch,  Abrechnungskonten.Stromverbrauch,  Abrechnungskonten.Personen,  Abrechnungskonten.Einheit,  Abrechnungskonten.Adresse,  Abrechnungskonten.Objekt,  Abrechnungskonten.Warmwasserverbrauch,  Abrechnungskonten.Waermeverbrauch,  Abrechnungskonten.Anmerkungen,  Abrechnungskonten.Anpassung,  Abrechnungskonten.Neuemiete,  Abrechnungskonten.Miteigentumsanteil2,  Abrechnungskonten.Miteigentumsanteil3,  Abrechnungskonten.Zaehlerinfo,  Abrechnungskonten.MwstSatz,  Abrechnungskonten.Erledigt,  Abrechnungskonten.Team,  Einheiten.Kaltmiete,  Einheiten.Nebenkosten,  Einheiten.Heizkosten,  Einheiten.Hausgeld,  (coalesce(Einheiten.Kaltmiete,0)+coalesce(Einheiten.Nebenkosten,0)+coalesce(Einheiten.Heizkosten,0)+coalesce(Einheiten.Hausgeld,0)) AS Gesamtleistung",
  "sqlFrom": "FROM Abrechnungskonten  LEFT OUTER JOIN Abrechnungen ON Abrechnungskonten.Abrechnung = Abrechnungen.ID  LEFT OUTER JOIN Einheiten ON Abrechnungskonten.Einheit = Einheiten.ID",
  "sqlWhere": "",
  "sqlTail": ""
 },
