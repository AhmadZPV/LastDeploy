  "entity": "Gesamtpersonen",
  "shortName": "Gesamtpersonen",
  "baseTable": "Personen",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY `Abrechnungskonten`.`Bezeichnung`, `Personen`.`Von`",
    "sqlHead": "SELECT `Personen`.`ID`,  `Personen`.`Abrechnungskonto`,  `Personen`.`Anzahl`,  `Personen`.`Von`,  `Personen`.`Bis`,  `Personen`.`Grund`,  @tage := datediff(`Personen`.`Bis`,`Personen`.`Von`)+1 AS `Tage`,  @personentage := Anzahl * @Tage AS `Personentage`,  @durchschnitt := round(@personentage / 365,1) AS `Durchschnitt`,  `Abrechnungskonten`.`Abrechnung`,  `Abrechnungskonten`.`Bezeichnung`,  Personen.Team",
    "sqlFrom": "FROM `Personen`  RIGHT OUTER JOIN `Abrechnungskonten` ON `Abrechnungskonten`.`ID` = `Personen`.`Abrechnungskonto`",
    "sqlWhere": "",
    "sqlTail": ""
  },
