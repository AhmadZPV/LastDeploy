{
  "entity": "Umsatzauswertung",
  "shortName": "Umsatzauswertung",
  "baseTable": "Positionen",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Verkauf.Rechnungsdatum DESC",
    "sqlHead": "SELECT Positionen.ID,  Positionen.Verkaufsvorgang,  Positionen.Menge,  Positionen.Bezeichnung as Leistung,  Positionen.Einheit,  Positionen.Listenpreis,  Positionen.Leistungscode,  Positionen.Mwst_Satz,  Verkauf.Kunde,  Verkauf.Rechnungsdatum,  Verkauf.Zahldatum,  Verkauf.Art,  Positionen.Menge*Positionen.Listenpreis as Umsatz,  if(Verkauf.Zahldatum IS Null, 'Offen', 'Bezahlt') AS Zahlstatus,  Positionen.Team",
    "sqlFrom": "FROM Positionen  LEFT OUTER JOIN Verkauf ON Positionen.Verkaufsvorgang = Verkauf.ID",
    "sqlWhere": "",
    "sqlTail": ""
  },
