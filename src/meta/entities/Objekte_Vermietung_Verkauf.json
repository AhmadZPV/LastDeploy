{
  "entity": "Objekte_Vermietung_Verkauf",
  "shortName": "Objekte_Vermietung_Verkauf",
  "baseTable": "Objekte",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY `Objekte`.`Bezeichnung`",
    "sqlHead": "SELECT `Objekte`.`ID`,  `Objekte`.`Bezeichnung`,  `Objekte`.`Nummer`,  `Objekte`.`Anschrift`,  `Objekte`.`Besitzer`,  `Objekte`.`Nutzer`,  `Objekte`.`Bemerkungen`,  `Objekte`.`Objektart`,  `Objekte`.`Baubeschreibung`,  `Objekte`.`Lage`,  `Objekte`.`Verkehrsanbindung`,  `Objekte`.`Infrastruktur`,  `Objekte`.`Ausstattung`,  `Objekte`.`Technik`,  `Objekte`.`Anschaffungsdatum`,  `Objekte`.`Fertigstellungsdatum`,  `Objekte`.`Einheitswert`,  `Objekte`.`Grundbuch`,  `Objekte`.`Grundstuecksgroesse`,  `Objekte`.`Bild`,  `Objekte`.`Miniatur`,  `Objekte`.`Detailfeld1`,  `Objekte`.`Detailfeld2`,  `Objekte`.`Detailfeld3`,  `Objekte`.`Detailfeld4`,  `Objekte`.`Detailfeld5`,  `Objekte`.`Laengengrad`,  `Objekte`.`Breitengrad`,  `Objekte`.`Anschrift` AS `Karte`,  case   when `Objektart` like \"%Verkauf%\" then \"Verkauf\"  when`Objektart` like \"%Vermietung%\" then \"Vermietung\"  end AS `Vermarktung`,  `Flaechen`.`Breite`,  `Flaechen`.`Anrechenbarkeit`,  `Flaechen`.`Tiefe`,  sum(`Flaechen`.`Breite`*`Flaechen`.`Tiefe`*`Flaechen`.`Anrechenbarkeit`) as Quadratmeter,  Objekte.Team",
    "sqlFrom": "FROM `Objekte`  LEFT OUTER JOIN `Einheiten` ON `Objekte`.`ID` = `Einheiten`.`Objekt`  LEFT OUTER JOIN `Raeume` ON `Einheiten`.`ID` = `Raeume`.`Einheit`  LEFT OUTER JOIN `Flaechen` ON `Raeume`.`ID` = `Flaechen`.`Raum`",
    "sqlWhere": "",
    "sqlTail": ""
  },
