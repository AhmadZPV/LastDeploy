{
  "entity": "Verkauf_Serienbrief_Steuerdatei",
  "shortName": "Verkauf_Serienbrief_Steuerdatei",
  "baseTable": "Verkauf",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Verkauf.ID",
    "sqlHead": "SELECT Verkauf.ID,  Verkauf.Kunde,  Verkauf.Nummer,  Verkauf.Datum,  Verkauf.Zahlungsbedingungen,  Verkauf.Lieferbedingungen,  Verkauf.Rechnungsdatum,  Verkauf.Leistungsdatum,  Verkauf.Art,  Verkauf.Bemerkungen,    Adressen.Firma,  Adressen.Abteilung,  Adressen.Vorname,  Adressen.Nachname,  Adressen.Strasse,  Adressen.PLZ,  Adressen.Ort,  Adressen.Anrede,  Adressen.Strasse_Liefer,  Adressen.PLZ_Liefer,  Adressen.Ort_Liefer,  Adressen.Staat_Liefer,    Positionen.Menge,  Positionen.Bezeichnung AS Bezeichnung,  Positionen.Einheit AS Einheit,  Positionen.Listenpreis,  Positionen.Leistungscode,  Positionen.Mwst_Satz,  Positionen.Bemerkungen AS Bemerkungen_Pos,  round(Menge*Listenpreis, 2) AS Netto,  Menge*Listenpreis*(1+Mwst_Satz/100) AS Brutto,  (Menge*Listenpreis*(1+Mwst_Satz/100))-(Menge*Listenpreis ) AS Mwst,  Verkauf.Team",
    "sqlFrom": "FROM Verkauf  LEFT OUTER JOIN Adressen ON Verkauf.Kunde = Adressen.ID  LEFT OUTER JOIN Positionen ON Verkauf.ID = Positionen.Verkaufsvorgang",
    "sqlWhere": "",
    "sqlTail": ""
  },
