{
 "entity": "Korrespondenz",
 "shortName": "Korrespondenz",
 "baseTable": "Korrespondenz",
 "isVirtual": false,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY Korrespondenz.Datum DESC",
  "sqlHead": "SELECT Korrespondenz.ID,  Korrespondenz.Art,  Korrespondenz.Postkorb,  Korrespondenz.Ordner,  Korrespondenz.Betreff,  Korrespondenz.Datum,  Korrespondenz.Wiedervorlage,  Korrespondenz.Zustaendigkeit,  Korrespondenz.Text,  Korrespondenz.Benutzer,  Korrespondenz.Adresse,  Korrespondenz.Inventar,  Adressen.Anrede,  Adressen.Email,  Concat(if(Adressen.Firma='','', Concat(Adressen.Firma, '\\n')), if(Adressen.Abteilung='','', Concat(Adressen.Abteilung, '\\n')), Adressen.Vorname, ' ', Adressen.Nachname, '\\n', Adressen.Strasse, '\\n', Adressen.PLZ, ' ', Adressen.Ort) AS Anschrift,  Einstellungen.Absenderzeile AS Absender,  Einstellungen.Ort AS Ort,  Einstellungen.Grussformel AS Gruss,  Einstellungen.Fussbereich AS Fuss,  Einstellungen.Logo,  Concat('<div style=\"font: Arial; font-size: 11pt; !important;\">', Einstellungen.Absenderzeile, if(Adressen.Firma='', '', Concat(Adressen.Firma, '<br>')), if(Adressen.Abteilung='', '', Concat(Adressen.Abteilung, '<br>')), Adressen.Vorname, ' ', Adressen.Nachname, '<br>', Adressen.Strasse, '<br>', Adressen.PLZ, ' ', Adressen.Ort, '<br><br><span style=\"float: right;\">', Einstellungen.Ort, ' ', Day(Korrespondenz.Datum), '.', Month(Korrespondenz.Datum), '.', Year(Korrespondenz.Datum), '</span>', '<br><br><strong>', Korrespondenz.Betreff, '</strong><br>', '<br>', Adressen.Anrede, '<br>', '<br>', Korrespondenz.Text, '<br>', '<br>', Einstellungen.Grussformel, '<br>', '<br>', Einstellungen.Fussbereich, '</div>') AS Brief,  Concat(Adressen.Email, '?subject=', Replace(Korrespondenz.Betreff,' ','%20'), '&body=', Replace(Replace(Replace(Concat(Adressen.Anrede,'%0D%0A',Korrespondenz.Text),'<br>','%0D%0A'),'</p>','%0D%0A'),'<p>','')) AS Mail,  Korrespondenz.Anhang,  Korrespondenz.Anhangname,  Korrespondenz.Gesendet,  Korrespondenz.Kopie,  Benutzer.Email AS Eigeneemail,  Benutzer.Name AS Eigenername,  Korrespondenz.Absendedatum,  Korrespondenz.Absendermail,  Korrespondenz.Muster,  Korrespondenz.IhrZeichen,  Korrespondenz.UnserZeichen,  Korrespondenz.Aktenzeichen,  Korrespondenz.Objekt,  Korrespondenz.Einheit,  Korrespondenz.Vertrag,  '' AS Nummernkreis,  Korrespondenz.Team,  Einheiten.Bezeichnung,  Einheiten.Einheitenart,  Einheiten.Etage,  Einheiten.Miteigentumsanteil,  Einheiten.Kaltmiete,  Einheiten.Nebenkosten,  Einheiten.Heizkosten,  Einheiten.Kaltmiete+Einheiten.Nebenkosten+Einheiten.Heizkosten AS Warmmiete,  Einheiten.Hausgeld,  Einheiten.Wohnflaeche,  Einheiten.Zimmer",
  "sqlFrom": "FROM Korrespondenz  LEFT OUTER JOIN Adressen ON Korrespondenz.Adresse = Adressen.ID  LEFT OUTER JOIN Benutzer ON Korrespondenz.Benutzer = Benutzer.Benutzername  LEFT OUTER JOIN Einheiten ON Korrespondenz.Einheit = Einheiten.ID  LEFT OUTER JOIN Einstellungen ON Korrespondenz.Team = Einstellungen.Team",
  "sqlWhere": "",
  "sqlTail": ""
 },
