{
  "entity": "Einheiten_Vermietung_Verkauf",
  "shortName": "Einheiten_Vermietung_Verkauf",
  "baseTable": "Einheiten",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY `Einheiten`.`Bezeichnung`, `Einheiten`.`Nummer`",
    "sqlHead": "SELECT `Einheiten`.`ID`,  `Einheiten`.`Bezeichnung`,  `Einheiten`.`Nummer`,  `Einheiten`.`Objekt`,  `Einheiten`.`Besitzer`,  `Einheiten`.`Nutzer`,  `Einheiten`.`Bemerkungen`,  `Einheiten`.`Einheitenart`,  `Einheiten`.`Technik`,  `Einheiten`.`Ausstattung`,  `Einheiten`.`Etage`,  `Einheiten`.`Miteigentumsanteil`,  `Einheiten`.`Eigenschaften`,  `Einheiten`.`Bild`,  `Einheiten`.`Miniatur`,  `Einheiten`.`Detailfeld1`,  `Einheiten`.`Detailfeld2`,  `Einheiten`.`Detailfeld3`,  `Einheiten`.`Detailfeld4`,  `Einheiten`.`Detailfeld5`,  `Einheiten`.`Kopfstimmen`,  case   when `Einheitenart` like \"%Verkauf%\" then \"Verkauf\"  when`Einheitenart` like \"%Vermietung%\" then \"Vermietung\"  end AS `Vermarktung`,  `Objekte`.`Anschrift`,  `Objekte`.`Objektart`,  `Objekte`.`Lage`,  `Objekte`.`Verkehrsanbindung`,  `Objekte`.`Infrastruktur`,  `Objekte`.`Technik` AS `Gebaeudetechnik`,  `Objekte`.`Ausstattung` AS `Gebaeudeausstattung`,  `Objekte`.`Fertigstellungsdatum` AS `Baujahr`,  `Objekte`.`Bild` AS `Objektbild`,  `Objekte`.`Miniatur` AS `Objektminiatur`,  `Objekte`.`Laengengrad`,  `Objekte`.`Breitengrad`,  `Objekte`.`Anschrift` AS `Karte`,  `Flaechen`.`Breite`,  `Flaechen`.`Anrechenbarkeit`,  `Flaechen`.`Tiefe`,  SUM(`Flaechen`.`Breite`*`Flaechen`.`Tiefe`*`Flaechen`.`Anrechenbarkeit`) AS `Quadratmeter`,  Einheiten.Team",
    "sqlFrom": "FROM `Einheiten`  LEFT OUTER JOIN `Objekte` ON `Einheiten`.`Objekt` = `Objekte`.`ID`  LEFT OUTER JOIN `Raeume` ON `Einheiten`.`ID` = `Raeume`.`Einheit`  LEFT OUTER JOIN `Flaechen` ON `Raeume`.`ID` = `Flaechen`.`Raum`",
    "sqlWhere": "",
    "sqlTail": ""
  },
