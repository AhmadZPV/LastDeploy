  "sql": {
    "strOrderBy": "ORDER BY Objekt, Einheit, Flaechen.Raum, Flaechen.Bezeichnung",
    "sqlHead": "SELECT Flaechen.ID,  Flaechen.Bezeichnung,  Flaechen.Breite,  Flaechen.Tiefe,  Flaechen.Anrechenbarkeit,  Flaechen.Hoehe,  Flaechen.Raum,  round(Breite*Tiefe*Anrechenbarkeit, 2) AS Quadratmeter,  round(Breite*Tiefe*Hoehe*Anrechenbarkeit, 2) AS Kubikmeter,  Einheiten.Bezeichnung AS Einheit,  Objekte.Bezeichnung AS Objekt,  Flaechen.Team",
    "sqlFrom": "FROM Flaechen  LEFT OUTER JOIN Raeume ON Flaechen.Raum = Raeume.ID  LEFT OUTER JOIN Einheiten ON Raeume.Einheit = Einheiten.ID  LEFT OUTER JOIN Objekte ON Einheiten.Objekt = Objekte.ID",
