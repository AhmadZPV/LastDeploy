 "sql": {
  "strOrderBy": "",
  "sqlHead": "SELECT `ID`,  Bezeichnung,  \t`Von`,  \t`Teilung`,  \t`Bis`,  \t`Betrag`,  \t@Zeitraum1 := datediff(Teilung,Von) as Zeitraum1,    @Zeitraum2 := datediff(Bis, Teilung) as Zeitraum2,    @Gesamtzeitraum := datediff(Bis,Von) as Gesamtzeitraum,  @Anteil1 :=@Zeitraum1/@Gesamtzeitraum,  @Anteil2 :=@Zeitraum2/@Gesamtzeitraum,  round(Betrag*@Anteil1,2) as Betrag1,  round(Betrag*@Anteil2,2) as Betrag2,  Team",
  "sqlFrom": "FROM `Aufteilungsassistent`",
  "sqlWhere": "",
  "sqlTail": ""
 },
