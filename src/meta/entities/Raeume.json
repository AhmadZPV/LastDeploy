  "sql": {
    "strOrderBy": "ORDER BY `Raeume`.`Nummer`, `Raeume`.`Bezeichnung`",
    "sqlHead": "SELECT `Raeume`.`ID`,  `Raeume`.`Bezeichnung`,  `Raeume`.`Nummer`,  `Raeume`.`Objekt`,  `Raeume`.`Einheit`,  `Raeume`.`Nutzer`,  `Raeume`.`Bemerkungen`,  `Raeume`.`Raumart`,  `Raeume`.`Technik`,  `Raeume`.`Ausstattung`,  `Raeume`.`Boden`,  `Raeume`.`Waende`,  `Raeume`.`Bild`,  `Raeume`.`Miniatur`,  `Raeume`.`Detailfeld1`,  `Raeume`.`Detailfeld2`,  `Raeume`.`Detailfeld3`,  `Raeume`.`Detailfeld4`,  `Raeume`.`Detailfeld5`,   '' as Nummernkreis,  Raeume.Team",
    "sqlFrom": "FROM `Raeume`  LEFT OUTER JOIN `Einheiten` ON `Raeume`.`Einheit` = `Einheiten`.`ID`  LEFT OUTER JOIN `Objekte` ON `Einheiten`.`Objekt` = `Objekte`.`ID`",
