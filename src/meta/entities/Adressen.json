  "strOrderBy": "ORDER BY `Kurzname`",
  "sqlHead": "SELECT `ID`,  `Kurzname`,  `Firma`,  `Abteilung`,  `Vorname`,  `Nachname`,  `Strasse`,  `PLZ`,  `Ort`,  `Bundesland`,  `Staat`,  `Benutzer`,  `Telefon`,  `Handy`,  `Email`,  `Website`,  `Telefax`,  `Bild`,  `Bemerkungen`,  `Laengengrad`,  `Breitengrad`,  `Klassifikation`,  `Geburtstag`,  `Geschlecht`,  `Anrede`,  `Titel`,  `Stellung`,  `Strasse_Liefer`,  `PLZ_Liefer`,  `Ort_Liefer`,  `Staat_Liefer`,  `UIDNr`,  `Bank`,  `IBAN`,  `Kontoinhaber`,  `Debitorennummer`,  `Kreditorennummer`,  `Paypal`,  `Wiedervorlage`,  `Skype`,  `Detailfeld1`,  `Detailfeld2`,  `Detailfeld3`,  `Detailfeld4`,  `Detailfeld5`,  `Bearbeitungsstatus`,  `Kundennummer`,  `Xing`,  `Linkedin`,  `Facebook`,  `Chat`,  `Telefonprivat`,  `Emailprivat`,  `Handyprivat`,  `Lieferbedingungen`,  `Zahlungsbedingungen`,  Concat(if(Adressen.Firma='','', Concat(Adressen.Firma, '\\n')), Adressen.Vorname, ' ', Adressen.Nachname, '\\n', Adressen.Strasse, '\\n', Adressen.PLZ, ' ', Adressen.Ort) AS `Karte`,  `Anschrift`,  `BIC`,  `Miniatur`,  `Partner_Vorname`,  `Partner_Nachname`,  `Anredeformat`,  `Etikett`,  `Favorit`,  '' AS `Nummernkreis`,  `Aktiv`,  Datenherkunft,  Erfassungsdatum,  MailURL,  DokumentenURL,  Team",
  "sqlFrom": "FROM `Adressen`",
