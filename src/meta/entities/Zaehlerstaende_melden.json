 "sql": {
  "strOrderBy": "ORDER BY Zaehler.Ablesedatum DESC",
  "sqlHead": "SELECT Zaehler.ID,  Zaehler.Raum,  Zaehler.Zaehlerart,  Zaehler.Zaehlernummer,  Zaehler.Zaehlerstand,  Zaehler.Ablesedatum,  Einheiten.Bezeichnung AS Einheit,  Objekte.Bezeichnung AS Objekt,  Zaehler.Ableser,  Zaehler.Unterschrift,  Einheiten.ID AS EinheitenID,  Objekte.ID AS ObjekteID,  Zaehler.Team",
  "sqlFrom": "FROM Zaehler  LEFT OUTER JOIN Raeume ON Zaehler.Raum = Raeume.ID  LEFT OUTER JOIN Einheiten ON Raeume.Einheit = Einheiten.ID  LEFT OUTER JOIN Objekte ON Einheiten.Objekt = Objekte.ID",
