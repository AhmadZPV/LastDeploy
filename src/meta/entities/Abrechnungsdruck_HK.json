{
  "entity": "Abrechnungsdruck_HK",
  "shortName": "Abrechnungsdruck_HK",
  "baseTable": "Kosten",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY `Kosten`.`Bezeichnung`",
    "sqlHead": "SELECT @tage := datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1 AS `Tage`,  @gesamttage := datediff(Abrechnungen.Bis,Abrechnungen.Von)+1 AS `Gesamttage`,  `Kosten`.`Bezeichnung`,  `Kosten`.`Betrag`,  `Kosten`.`Umlageart`,  `Kosten`.`Art`,  `Abrechnungen`.`ID` AS `Abrechnung`,  `Abrechnungen`.`Von` AS `Abrechnung_Von`,  `Abrechnungen`.`Bis` AS `Abrechnung_Bis`,  `Abrechnungskonten`.`ID` AS `Abrechnungskonto`,  Abrechnungen.Grundkostenanteil / 100 AS `Grundkostenanteil_Proz`,  (100-Abrechnungen.Grundkostenanteil)/100 AS `Verbrauchskostenanteil_Proz`,  `Abrechnungen`.`Grundkostenanteil`,  (100-Abrechnungen.Grundkostenanteil) AS `Verbrauchskostenanteil`,  (Abrechnungskonten.Quadratmeter*@tage)/(Abrechnungen.Quadratmeter*@gesamttage/100)*(Abrechnungen.Grundkostenanteil/100) AS `QM_Anteil_Proz`,  if(Kosten.Umlageart='Heizung', round(((Kosten.Betrag*(Abrechnungskonten.Quadratmeter*@tage)/(Abrechnungen.Quadratmeter*@gesamttage/100)/100)*(Abrechnungen.Grundkostenanteil/100)), 2), '') AS `Grundkostenteil`,  if(Kosten.Umlageart='Heizung', round(Kosten.Betrag*((100-Abrechnungen.Grundkostenanteil)/100) * (Abrechnungskonten.Warmwasserverbrauch/Abrechnungen.Waermemengenzaehler/100) * (Abrechnungen.Waermemengenzaehler/Abrechnungen.Waermeverbrauch*100),2), '') AS `WW_Verbrauchskostenteil`,  if(Kosten.Umlageart='Heizung', round(Kosten.Betrag*((100-Abrechnungen.Grundkostenanteil)/100) * (Abrechnungskonten.Waermeverbrauch/Abrechnungen.Waermeverbrauch/100) * (100-(Abrechnungen.Waermemengenzaehler/Abrechnungen.Waermeverbrauch*100)),2), '') AS `HZ_Verbrauchskostenteil`,  `Abrechnungen`.`Waermemengenzaehler`,  `Abrechnungen`.`Waermeverbrauch` AS `Waermeverbrauch_Gesamt`,  `Abrechnungskonten`.`Warmwasserverbrauch`,  (Abrechnungen.Waermemengenzaehler/Abrechnungen.Waermeverbrauch*100) AS `WW_Anteil_Gesamt`,  `Abrechnungskonten`.`Waermeverbrauch` AS `Waermeverbrauch`,  100-(Abrechnungen.Waermemengenzaehler/Abrechnungen.Waermeverbrauch*100) AS `HZ_Anteil_Gesamt`,  if(Kosten.Umlageart='Quadratmeter', round((Kosten.Betrag*(Abrechnungskonten.Quadratmeter*@tage)/(Abrechnungen.Quadratmeter*@gesamttage/100)/100),2), if(Kosten.Umlageart='Heizung',   round((((Abrechnungskonten.Quadratmeter*@tage)/(Abrechnungen.Quadratmeter*@gesamttage/100)/100)*(Abrechnungen.Grundkostenanteil/100)*Kosten.Betrag),2)+  round(Kosten.Betrag*((100-Abrechnungen.Grundkostenanteil)/100) * (Abrechnungskonten.Warmwasserverbrauch/Abrechnungen.Waermemengenzaehler/100) * (Abrechnungen.Waermemengenzaehler/Abrechnungen.Waermeverbrauch*100),2)+  round(Kosten.Betrag*((100-Abrechnungen.Grundkostenanteil)/100) * (Abrechnungskonten.Waermeverbrauch/Abrechnungen.Waermeverbrauch/100) * (100-(Abrechnungen.Waermemengenzaehler/Abrechnungen.Waermeverbrauch*100)),2),     if(Kosten.Art='Direkte Kosten' AND Kosten.Abrechnungskonto=Abrechnungskonten.ID,Kosten.Betrag*1,  if(Kosten.Art='Vorauszahlungen' AND Kosten.Abrechnungskonto=Abrechnungskonten.ID,Kosten.Betrag*-1  ,'')))) AS `Anteil`,  `Abrechnungen`.`Quadratmeter` AS `Gesamt_Quadratmeter`,  `Abrechnungen`.`Einheiten`,  `Abrechnungskonten`.`Von`,  `Abrechnungskonten`.`Bis`,  `Abrechnungskonten`.`Quadratmeter` AS `Quadratmeter`,  `Abrechnungskonten`.`Anschrift`,  `Abrechnungen`.`Anmerkungen`,  `Abrechnungskonten`.`Anmerkungen` AS `Anmerkungen1`,  Abrechnungskonten.Zaehlerinfo,  `Abrechnungskonten`.`Anpassung`,  Kosten.Team",
    "sqlFrom": "FROM `Kosten`  LEFT OUTER JOIN `Abrechnungen` ON `Kosten`.`Abrechnung` = `Abrechnungen`.`ID`  INNER JOIN `Abrechnungskonten` ON `Abrechnungen`.`ID` = `Abrechnungskonten`.`Abrechnung`",
    "sqlWhere": "",
    "sqlTail": ""
  },
