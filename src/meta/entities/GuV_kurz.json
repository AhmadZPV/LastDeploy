  "sql": {
    "strOrderBy": "ORDER BY `Kontenrahmen`.`Buchfuehrung`, `Kontenrahmen`.`Guv`, `Kontenrahmen`.`Nummer`, `Buchungen`.`Datum`",
    "sqlHead": "SELECT `Kontenrahmen`.`ID`,  `Kontenrahmen`.`Buchfuehrung`,  `Kontenrahmen`.`Guv`,    `Kontenrahmen`.`Nummer`,  `Kontenrahmen`.`Kontobezeichnung`,  Concat(`Kontenrahmen`.`Nummer`,' ',`Kontenrahmen`.`Kontobezeichnung`) as Konto,  `Buchungen`.`Betreff`,  `Buchungen`.`Datum`,  if(Kontenrahmen.ID=Buchungen.Konto,`Buchungen`.`Betrag`,0) as Betraglinks,  if(Kontenrahmen.ID=Buchungen.Gegenkonto,`Buchungen`.`Betrag`,0) as Betragrechts,      if(Kontenrahmen.ID=Buchungen.Konto,`Buchungen`.`Betrag`*-1,Betrag) as Saldo,    Kontenrahmen.Team",
    "sqlFrom": "FROM `Kontenrahmen`  LEFT OUTER JOIN `Buchungen` ON `Kontenrahmen`.`ID` = `Buchungen`.`Konto` OR `Kontenrahmen`.`ID` = `Buchungen`.`Gegenkonto`",
    "sqlWhere": "",
    "sqlTail": ""
  },
