{
  "entity": "Mieterkonten_Saldenliste",
  "shortName": "Mieterkonten_Saldenliste",
  "baseTable": "Kontobuch",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY @saldo",
    "sqlHead": "SELECT `Kontobuch`.`ID`,  @saldo:=SUM(if(Art=\"Einnahme\", `Betrag`, -1*Betrag)) AS `Betrag`,  SUM(if(Art=\"Einnahme\", `Betrag`, 0)) AS `Zahlungen`,  SUM(if(Art=\"Sollstellung\", `Betrag`, 0)) AS `Forderungen`,  `Kontobuch`.`Abrechnung`,  `Kontobuch`.`Abrechnungskonto`,  `Adressen`.`Firma`,  `Adressen`.`Abteilung`,  `Adressen`.`Vorname`,  `Adressen`.`Nachname`,  `Adressen`.`Strasse`,  `Adressen`.`PLZ`,  `Adressen`.`Ort`,  `Adressen`.`Bundesland`,  `Adressen`.`Staat`,  `Adressen`.`Telefon`,  `Adressen`.`Handy`,  `Adressen`.`Email`,  `Adressen`.`Anrede`,  `Adressen`.`Bank`,  `Adressen`.`IBAN`,  `Adressen`.`Kontoinhaber`,  Kontobuch.Team",
    "sqlFrom": "FROM `Kontobuch`  INNER JOIN `Abrechnungskonten` ON `Kontobuch`.`Abrechnungskonto` = `Abrechnungskonten`.`ID`  INNER JOIN `Adressen` ON `Abrechnungskonten`.`Adresse` = `Adressen`.`ID`",
    "sqlWhere": "",
    "sqlTail": ""
  },
  "keys": [
    "ID"
  ],
  "pageSize": 20,
