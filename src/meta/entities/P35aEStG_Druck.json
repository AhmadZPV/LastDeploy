{
 "entity": "P35aEStG_Druck",
 "shortName": "P35aEStG_Druck",
 "baseTable": "Kosten",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY `Kosten`.`Bezeichnung`",
  "sqlHead": "SELECT @tage := datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1 as Tage,  @gesamttage := datediff(Abrechnungen.Bis,Abrechnungen.Von)+1 as Gesamttage,    `Kosten`.`Bezeichnung`,  `Kosten`.`Betrag`,  `Kosten`.`Umlageart`,  `Kosten`.`Art`,  `Abrechnungen`.`ID` AS `Abrechnung`,  `Abrechnungen`.`Von` AS `Abrechnung_Von`,  `Abrechnungen`.`Bis` AS `Abrechnung_Bis`,  `Abrechnungskonten`.`ID` AS `Abrechnungskonto`,    @qmanteil:=(Abrechnungskonten.Quadratmeter*@tage)/(Abrechnungen.Quadratmeter*@gesamttage/100) AS `QM_Anteil`,  @ehanteil:=(1*@tage)/(Abrechnungen.Einheiten*(@gesamttage)/100) AS `Einheiten_Anteil`,  @qmanteil2:=(Abrechnungskonten.Quadratmeter2*@tage)/(Abrechnungen.Quadratmeter2*@gesamttage/100) AS `QM_Anteil2`,  @ehanteil2:=(Abrechnungskonten.Einheiten2*@tage)/(Abrechnungen.Einheiten2*@gesamttage/100) AS `Einheiten_Anteil2`,  @meaanteil:=(Abrechnungskonten.Miteigentumsanteil*@tage)/(Abrechnungen.Miteigentumsanteile*@gesamttage/100) AS `MEA_Anteil`,  @meaanteil2:=(Abrechnungskonten.Miteigentumsanteil2*@tage)/(Abrechnungen.Miteigentumsanteile2*@gesamttage/100) AS `MEA_Anteil2`,      if(Kosten.Umlageart='Quadratmeter', round((Kosten.Betrag*(Abrechnungskonten.Quadratmeter*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Quadratmeter*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100)/100),2), if(Kosten.Umlageart='Einheiten', round((Kosten.Betrag*(1*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Einheiten*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100)/100),2),  if(Kosten.Umlageart='Quadratmeter 2', round((Kosten.Betrag*(Abrechnungskonten.Quadratmeter2*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Quadratmeter2*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100)/100),2),   if(Kosten.Umlageart='Einheiten 2', round((Kosten.Betrag*(Abrechnungskonten.Einheiten2*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Einheiten2*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100)/100),2),  if(Kosten.Umlageart='Miteigentumsanteile', round((Kosten.Betrag*(Abrechnungskonten.Miteigentumsanteil*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Miteigentumsanteile*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100)/100),2),  if(Kosten.Umlageart='Miteigentumsanteile 2', round((Kosten.Betrag*(Abrechnungskonten.Miteigentumsanteil2*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Miteigentumsanteile2*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100)/100),2)  ,'')))))) AS `Anteil`,        @gqm:=`Abrechnungen`.`Quadratmeter` AS `Gesamt_Quadratmeter`,  @geh:=`Abrechnungen`.`Einheiten` AS `Gesamt_Einheiten`,  `Abrechnungskonten`.`Von`,  `Abrechnungskonten`.`Bis`,  @qm:=`Abrechnungskonten`.`Quadratmeter` AS `Quadratmeter`,  `Abrechnungskonten`.`Anschrift`,  @geh2:=`Abrechnungen`.`Einheiten2` AS `Gesamt_Einheiten2`,  @gqm2:=`Abrechnungen`.`Quadratmeter2` AS `Gesamt_Quadratmeter2`,  @eh2:=`Abrechnungskonten`.`Einheiten2` AS `Einheiten2`,  @qm2:=`Abrechnungskonten`.`Quadratmeter2` AS `Quadratmeter2`,  @mea:=`Abrechnungskonten`.`Miteigentumsanteil`,  @gmea:=`Abrechnungen`.`Miteigentumsanteile`,  @mea2:=`Abrechnungskonten`.`Miteigentumsanteil2`,  @gmea2:=`Abrechnungen`.`Miteigentumsanteile2`,      @QMFormel:=Concat(\"<tr><td>Quadratmeter</td><td>(\",@qm,\" QM * \",@tage,\" Tage) / (\",@gqm,\" Gesamt-QM * \",@gesamttage,\" Gesamt-Tage)</td><td align='right'> \",round(@qmanteil,2),\" %</td></tr>\") as QMFormel,  @EHFormel:=Concat(\"<tr><td>Einheiten</td><td>(1 Einheit * \",@tage,\" Tage) / (\",@geh,\" Gesamt-Einheiten * \",@gesamttage,\" Gesamt-Tage)</td><td align='right'> \",round(@ehanteil,2),\" %</td></tr>\") as EhFormel,  @QMFormel2:=if(@gqm2 is not null,Concat(\"<tr><td>Quadratmeter2</td><td>(\",@qm2,\" QM * \",@tage,\" Tage) / (\",@gqm2,\" Gesamt-QM * \",@gesamttage,\" Gesamt-Tage)</td><td align='right'> \",round(@qmanteil2,2),\" %</td></tr>\"),\"\") as QMFormel2,  @EHFormel2:=if(@geh2 is not null,Concat(\"<tr><td>Einheiten2</td><td>(\",@eh2 ,\" Einheit * \",@tage,\" Tage) / (\",@geh2,\" Gesamt-Einheiten * \",@gesamttage,\" Gesamt-Tage)</td><td align='right'> \",round(@ehanteil2,2),\" %</td></tr>\"),\"\") as EhFormel2,  @MEAFormel:=if(@gmea is not null,Concat(\"<tr><td>MEA</td><td>(\",@mea ,\" Eigentumsanteile * \",@tage,\" Tage) / (\",@gmea,\" Gesamt-Eigentumsanteile * \",@gesamttage,\" Gesamt-Tage)</td><td align='right'> \",round(@meaanteil,2),\" %</td></tr>\"),\"\") as MEAFormel,  @MEAFormel2:=if(@gmea2 is not null,Concat(\"<tr><td>MEA2</td><td>(\",@mea2 ,\" Eigentumsanteile * \",@tage,\" Tage) / (\",@gmea2,\" Gesamt-Eigentumsanteile * \",@gesamttage,\" Gesamt-Tage)</td><td align='right'> \",round(@meaanteil2,2),\" %</td></tr>\"),\"\") as MEAFormel2,    Concat(\"<table style='white-space: normal; background-color: rgb(255, 255, 255); font-size:80% !important;' ><tr><td>Umlageart</td><td>Berechnung</td><td align='right'>Anteil</td></tr>\",coalesce(@QMFormel,\"\"),coalesce(@EHFormel,\"\"),coalesce(@QMFormel2,\"\"),coalesce(@EhFormel2,\"\"),coalesce(@MEAFormel,\"\"),coalesce(@MEAFormel2,\"\"),\"</table>\") as Umlagefaktoren,        `Kosten`.`Materialanteil`,  Coalesce(Kosten.Betrag,0)+Coalesce(Kosten.Materialanteil,0) as Gesamtbetrag,  Kosten.Team",
  "sqlFrom": "FROM `Kosten`  LEFT OUTER JOIN `Abrechnungen` ON `Kosten`.`Abrechnung` = `Abrechnungen`.`ID`  INNER JOIN `Abrechnungskonten` ON `Abrechnungen`.`ID` = `Abrechnungskonten`.`Abrechnung`",
  "sqlWhere": "",
  "sqlTail": ""
 },
