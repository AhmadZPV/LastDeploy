{
  "entity": "Verkauf",
  "shortName": "Verkauf",
  "baseTable": "Verkauf",
  "isVirtual": false,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Verkauf.Datum DESC",
    "sqlHead": "SELECT Verkauf.ID,  Verkauf.Kunde,  Verkauf.Nummer,  Verkauf.Datum,  Verkauf.Zahlungsbedingungen,  Verkauf.Lieferbedingungen,  Verkauf.Rechnungsdatum,  Verkauf.Leistungsdatum,  Concat(if(Adressen.Firma='','', Concat(Adressen.Firma, '<br>')), if(Adressen.Abteilung='','', Concat(Adressen.Abteilung, '<br>')), Adressen.Vorname, ' ', Adressen.Nachname, '<br>', Adressen.Strasse, '<br>', Adressen.PLZ, ' ', Adressen.Ort) AS Anschrift,  Verkauf.Art,  Verkauf.Bemerkungen,  Verkauf.Zahldatum,  Verkauf.Bezeichnung,  Verkauf.Objekt,  Verkauf.Einheit,  Verkauf.Team",
    "sqlFrom": "FROM Verkauf  LEFT OUTER JOIN Adressen ON Verkauf.Kunde = Adressen.ID",
    "sqlWhere": "",
    "sqlTail": ""
  },
