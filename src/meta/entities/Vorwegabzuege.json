  "sql": {
    "strOrderBy": "",
    "sqlHead": "SELECT ID,  \t`Anteil 1`,  \t`Anteil 2`,  \t`Anteil 3`,  \t`Anteil 4`,  \tBetrag,  \tBezeichnung,  \tTeam,  \t@Gesamt := `Anteil 1`+coalesce(`Anteil 2`,0)+coalesce(`Anteil 3`,0)+coalesce(`Anteil 4`,0) as Gesamt,  \t@Betrag1 := round(Betrag * (`Anteil 1`/@Gesamt),2) as Betrag1,  \t@Betrag2 := round(Betrag * (`Anteil 2`/@Gesamt),2) as Betrag2,  \t@Betrag3 := round(Betrag * (`Anteil 3`/@Gesamt),2) as Betrag3,  \t@Betrag4 := round(Betrag * (`Anteil 4`/@Gesamt),2) as Betrag4",
    "sqlFrom": "FROM Vorwegabzuege",
    "sqlWhere": "",
    "sqlTail": ""
