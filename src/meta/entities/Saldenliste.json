{
 "entity": "Saldenliste",
 "shortName": "Saldenliste",
 "baseTable": "Kontenrahmen",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY `Kontenrahmen`.`Buchfuehrung`, `Kontenrahmen`.`Klasse`, `Kontenrahmen`.`Gruppe`, `Kontenrahmen`.`Nummer`",
  "sqlHead": "SELECT `Kontenrahmen`.`ID`,  `Kontenrahmen`.`Buchfuehrung`,  `Kontenrahmen`.`Klasse`,  `Kontenrahmen`.`Gruppe`,  `Kontenrahmen`.`Nummer`,  `Kontenrahmen`.`Kontobezeichnung`,  Concat(`Kontenrahmen`.`Nummer`,' ',`Kontenrahmen`.`Kontobezeichnung`) as Konto,    @Betraglinks := (select sum(Betrag) from Buchungen where Kontenrahmen.ID=Buchungen.Konto) as Betraglinks,  @Betragrechts := (select sum(Betrag) from Buchungen where Kontenrahmen.ID=Buchungen.Gegenkonto) as Betragrechts,    cast(case   when @Betraglinks is Null then @Betragrechts  when @Betragrechts is Null then @Betraglinks  when @Betraglinks>=@Betragrechts then @Betraglinks-@Betragrechts  when @Betragrechts>@Betraglinks then @Betragrechts-@Betraglinks  end as decimal(11,2)) as Saldo,        Kontenrahmen.Team",
  "sqlFrom": "FROM `Kontenrahmen`  LEFT OUTER JOIN `Buchungen` ON `Kontenrahmen`.`ID` = `Buchungen`.`Konto` OR `Kontenrahmen`.`ID` = `Buchungen`.`Gegenkonto`",
  "sqlWhere": "",
  "sqlTail": ""
 },
