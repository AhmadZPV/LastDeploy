{
 "entity": "Abrechnungsdaten__bersicht",
 "shortName": "Abrechnungsdaten__bersicht",
 "baseTable": "Kosten",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY Abrechnung, ID, Kosten.Art, Kosten.Bezeichnung",
  "sqlHead": "SELECT @tage := datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von)+1 AS Tage,  @gesamttage := datediff(Abrechnungen.Bis,Abrechnungen.Von)+1 AS Gesamttage,  Kosten.Bezeichnung,  Kosten.Nettobetrag AS Betrag,  Kosten.Betrag AS `Betrag brutto`,  Kosten.Umlageart,  Kosten.Art,  Abrechnungen.ID AS Abrechnung,  Abrechnungen.Von AS Abrechnung_Von,  Abrechnungen.Bis AS Abrechnung_Bis,  Abrechnungskonten.ID AS ID,  (Abrechnungskonten.Quadratmeter*@tage)/(Abrechnungen.Quadratmeter*@gesamttage/100) AS QM_Anteil,  (1*@tage)/(Abrechnungen.Einheiten*(@gesamttage)/100) AS Einheiten_Anteil,  (Abrechnungskonten.Quadratmeter2*@tage)/(Abrechnungen.Quadratmeter2*@gesamttage/100) AS QM_Anteil2,  (Abrechnungskonten.Quadratmeter3*@tage)/(Abrechnungen.Quadratmeter3*@gesamttage/100) AS QM_Anteil3,  (Abrechnungskonten.Einheiten2*@tage)/(Abrechnungen.Einheiten2*@gesamttage/100) AS Einheiten_Anteil2,  (Abrechnungskonten.Miteigentumsanteil*@tage)/(Abrechnungen.Miteigentumsanteile*@gesamttage/100) AS MEA_Anteil,  (Abrechnungskonten.Miteigentumsanteil2*@tage)/(Abrechnungen.Miteigentumsanteile2*@gesamttage/100) AS MEA_Anteil2,  (Abrechnungskonten.Wasserverbrauch)/(Abrechnungen.Wasserverbrauch/100) AS Wasserverbrauch_Anteil,  (Abrechnungskonten.Muellverbrauch*@tage)/(Abrechnungen.Muellverbrauch*@gesamttage/100) AS Muellverbrauch_Anteil,  (Abrechnungskonten.Stromverbrauch*@tage)/(Abrechnungen.Stromverbrauch*@gesamttage/100) AS Stromverbrauch_Anteil,  (Abrechnungskonten.Personen*@tage)/(Abrechnungen.Personen*@gesamttage/100) AS Personen_Anteil,  @anteil:=CASE  WHEN Kosten.Umlageart = 'Quadratmeter'  \t\t\t\t THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Quadratmeter * @tage) / (Abrechnungen.Quadratmeter * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Einheiten'          THEN ROUND((Kosten.Nettobetrag * (1 * @tage) / (Abrechnungen.Einheiten * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Quadratmeter 2'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Quadratmeter2 * @tage) / (Abrechnungen.Quadratmeter2 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Quadratmeter 3'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Quadratmeter3 * @tage) / (Abrechnungen.Quadratmeter3 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Einheiten 2'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Einheiten2 * @tage) / (Abrechnungen.Einheiten2 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Einheiten 3'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Einheiten3 * @tage) / (Abrechnungen.Einheiten3 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Wasserverbrauch'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Wasserverbrauch) / (Abrechnungen.Wasserverbrauch / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Müllverbrauch'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Muellverbrauch * @tage) / (Abrechnungen.Muellverbrauch * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Stromverbrauch'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Stromverbrauch * @tage) / (Abrechnungen.Stromverbrauch * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Miteigentumsanteile'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Miteigentumsanteil * @tage) / (Abrechnungen.Miteigentumsanteile * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Miteigentumsanteile 2'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Miteigentumsanteil2 * @tage) / (Abrechnungen.Miteigentumsanteile2 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Miteigentumsanteile 3'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Miteigentumsanteil3 * @tage) / (Abrechnungen.Miteigentumsanteile3 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Personen'          THEN ROUND((Kosten.Nettobetrag * (Abrechnungskonten.Personen * @tage) / (Abrechnungen.Personen * @gesamttage / 100) / 100), 2)  WHEN Kosten.Art = 'Direkte Kosten' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Nettobetrag * 1  WHEN Kosten.Art = 'Vorauszahlungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Nettobetrag * - 1  WHEN Kosten.Art = 'Rücklage Forderungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Nettobetrag * 1  WHEN Kosten.Art = 'Rücklage Zahlungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Nettobetrag * - 1  END AS Anteil,  @anteilbrutto:=CASE  WHEN Kosten.Umlageart = 'Quadratmeter'  \t\t\t\t THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Quadratmeter * @tage) / (Abrechnungen.Quadratmeter * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Einheiten'          THEN ROUND((Kosten.Betrag * (1 * @tage) / (Abrechnungen.Einheiten * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Quadratmeter 2'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Quadratmeter2 * @tage) / (Abrechnungen.Quadratmeter2 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Einheiten 2'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Einheiten2 * @tage) / (Abrechnungen.Einheiten2 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Einheiten 3'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Einheiten3 * @tage) / (Abrechnungen.Einheiten3 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Wasserverbrauch'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Wasserverbrauch) / (Abrechnungen.Wasserverbrauch / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Müllverbrauch'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Muellverbrauch * @tage) / (Abrechnungen.Muellverbrauch * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Stromverbrauch'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Stromverbrauch * @tage) / (Abrechnungen.Stromverbrauch * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Miteigentumsanteile'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Miteigentumsanteil * @tage) / (Abrechnungen.Miteigentumsanteile * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Miteigentumsanteile 2'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Miteigentumsanteil2 * @tage) / (Abrechnungen.Miteigentumsanteile2 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Miteigentumsanteile 3'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Miteigentumsanteil3 * @tage) / (Abrechnungen.Miteigentumsanteile3 * @gesamttage / 100) / 100), 2)  WHEN Kosten.Umlageart = 'Personen'          THEN ROUND((Kosten.Betrag * (Abrechnungskonten.Personen * @tage) / (Abrechnungen.Personen * @gesamttage / 100) / 100), 2)  WHEN Kosten.Art = 'Direkte Kosten' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Betrag * 1  WHEN Kosten.Art = 'Vorauszahlungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Betrag * - 1  WHEN Kosten.Art = 'Rücklage Forderungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Betrag * 1  WHEN Kosten.Art = 'Rücklage Zahlungen' AND Kosten.Abrechnungskonto = Abrechnungskonten.ID          THEN Kosten.Betrag * - 1  END AS Anteilbrutto,  Abrechnungen.Quadratmeter AS Gesamt_Quadratmeter,  Abrechnungen.Einheiten AS Gesamt_Einheiten,  Abrechnungskonten.Von,  Abrechnungskonten.Bis,  Abrechnungskonten.Quadratmeter AS Quadratmeter,  Abrechnungskonten.Anschrift,  Abrechnungen.Personen AS Personenschnitt,  Abrechnungskonten.Personen AS Personen,  Abrechnungen.Wasserverbrauch AS Gesamt_Wasser,  Abrechnungen.Muellverbrauch AS Gesamt_Muell,  Abrechnungen.Stromverbrauch AS Gesamt_Strom,  Abrechnungskonten.Wasserverbrauch,  Abrechnungskonten.Muellverbrauch,  Abrechnungen.Einheiten2 AS Gesamt_Einheiten2,  Abrechnungen.Quadratmeter2 AS Gesamt_Quadratmeter2,  Abrechnungskonten.Einheiten2 AS Einheiten2,  Abrechnungskonten.Quadratmeter2 AS Quadratmeter2,  Abrechnungskonten.Miteigentumsanteil,  Abrechnungen.Miteigentumsanteile,  Abrechnungskonten.Miteigentumsanteil2,  Abrechnungen.Miteigentumsanteile2,  Abrechnungen.Anmerkungen,  Abrechnungskonten.Anmerkungen AS Anmerkungen1,  Abrechnungskonten.Anpassung,  Abrechnungskonten.Neuemiete,  Kosten.Team",
  "sqlFrom": "FROM Kosten  LEFT OUTER JOIN Abrechnungen ON Kosten.Abrechnung = Abrechnungen.ID  INNER JOIN Abrechnungskonten ON Abrechnungen.ID = Abrechnungskonten.Abrechnung",
  "sqlWhere": "",
  "sqlTail": ""
 },
