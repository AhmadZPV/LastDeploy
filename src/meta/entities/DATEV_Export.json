{
 "entity": "DATEV_Export",
 "shortName": "DATEV_Export",
 "baseTable": "Buchungen",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY Buchungen.Belegnummer DESC",
  "sqlHead": "SELECT Buchungen.ID,  Buchungen.Buchfuehrung,  Buchungen.Konto AS Kontonummer,  Kontenrahmen.Kontobezeichnung AS Konto,  Buchungen.Gegenkonto AS Gegenkontonummer,  Kontenrahmen1.Kontobezeichnung AS Gegenkonto,  Buchungen.Betreff,  Buchungen.Belegnummer,  Buchungen.DATEV_Betragskennzeichen AS DATEVBetragskennzeichen,  Buchungen.DATEV_Steuerschluessel AS DATEVSteuerschluessel,  0 AS DATEVFestschreibekennzeichen,  concat(lpad(day(Buchungen.Datum),2,'0'),lpad(month(Buchungen.Datum),2,'0'),year(Buchungen.Datum)) as DATEVDatum,  round(Betrag*100, 0) AS DATEVBetrag,  Buchungen.Datum,  Buchungen.Team",
  "sqlFrom": "FROM Buchungen  LEFT OUTER JOIN Kontenrahmen ON Buchungen.Konto = Kontenrahmen.ID  LEFT OUTER JOIN Kontenrahmen AS Kontenrahmen1 ON Buchungen.Gegenkonto = Kontenrahmen1.ID",
  "sqlWhere": "",
  "sqlTail": ""
 },
