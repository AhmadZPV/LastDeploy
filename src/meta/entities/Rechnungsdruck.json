{
 "entity": "Rechnungsdruck",
 "shortName": "Rechnungsdruck",
 "baseTable": "Verkauf",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY Verkauf.ID DESC",
  "sqlHead": "SELECT Verkauf.ID,  Verkauf.Kunde,  Verkauf.Nummer,  Verkauf.Datum,  Verkauf.Zahlungsbedingungen,  Verkauf.Lieferbedingungen,  Verkauf.Rechnungsdatum,  Verkauf.Leistungsdatum,  Verkauf.Art,  Adressen.Kundennummer,  Adressen.Anrede,  Positionen.Menge,  Positionen.Bezeichnung,  Positionen.Einheit,  Positionen.Listenpreis,  Positionen.Leistungscode,  Positionen.Mwst_Satz,  round(Menge*Listenpreis, 2) AS Netto,  Menge*Listenpreis*(1+Mwst_Satz/100) AS Brutto,  (Menge*Listenpreis*(1+Mwst_Satz/100))-(Menge*Listenpreis ) AS Mwst,  Concat(if(Adressen.Firma='','', Concat(Adressen.Firma, '<br>')), if(Adressen.Abteilung='','', Concat(Adressen.Abteilung, '<br>')), Adressen.Vorname, ' ', Adressen.Nachname, '<br>', Adressen.Strasse, '<br>', Adressen.PLZ, ' ', Adressen.Ort) AS Anschrift,  Verkauf.Bemerkungen AS Gesamtbemerkung,  Positionen.Bemerkungen AS Positionsbemerkung,  if(Positionen.Bemerkungen is null, Positionen.Bezeichnung, concat(Positionen.Bezeichnung,'<br>',Positionen.Bemerkungen)) AS Positionstext,  Einstellungen.Absenderzeile,  Einstellungen.Grussformel,  Einstellungen.Fussbereich,  Einstellungen.LogoLink,  Einstellungen.Rechnungslayout,  Verkauf.Team,  Verkauf.Seriennummer",
  "sqlFrom": "FROM Verkauf  LEFT OUTER JOIN Adressen ON Verkauf.Kunde = Adressen.ID  LEFT OUTER JOIN Positionen ON Verkauf.ID = Positionen.Verkaufsvorgang  , Einstellungen",
  "sqlWhere": "",
  "sqlTail": ""
 },
