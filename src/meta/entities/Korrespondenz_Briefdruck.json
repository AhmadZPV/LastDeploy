{
  "entity": "Korrespondenz_Briefdruck",
  "shortName": "Korrespondenz_Briefdruck",
  "baseTable": "Korrespondenz",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Datum DESC",
    "sqlHead": "SELECT Korrespondenz.ID,  Korrespondenz.Adresse,  Korrespondenz.Zustaendigkeit,  Korrespondenz.Inventar,  Concat(if(Adressen.Firma='','', Concat(Adressen.Firma, '<br>')), if(Adressen.Abteilung='','', Concat(Adressen.Abteilung, '<br>')), Adressen.Vorname, ' ', Adressen.Nachname, '<br>', Adressen.Strasse, '<br>', Adressen.PLZ, ' ', Adressen.Ort) AS Anschrift,  Korrespondenz.Datum AS Datum,  Adressen.Anrede AS Anrede,  Korrespondenz.Betreff AS Betreff,  Korrespondenz.Text AS Brief,  Einstellungen.Grussformel AS Gruss,  Einstellungen.Ort AS Ort,  Einstellungen.Fussbereich AS Fuss,  Einstellungen.Absenderzeile AS Absender,  Einstellungen.Logo AS Logo,  Einstellungen.LogoLink AS LogoLink,  Einstellungen.Brieflayout,  Korrespondenz.IhrZeichen,  Korrespondenz.UnserZeichen,  Korrespondenz.Aktenzeichen,  Korrespondenz.Team,  Einheiten.Bezeichnung,  Einheiten.Einheitenart,  Einheiten.Etage,  Einheiten.Miteigentumsanteil,  Einheiten.Kaltmiete,  Einheiten.Nebenkosten,  Einheiten.Heizkosten,  Einheiten.Kaltmiete+Einheiten.Nebenkosten+Einheiten.Heizkosten AS Warmmiete,  Einheiten.Hausgeld,  Einheiten.Wohnflaeche,  Einheiten.Zimmer",
    "sqlFrom": "FROM Korrespondenz  LEFT OUTER JOIN Adressen ON Korrespondenz.Adresse = Adressen.ID  LEFT OUTER JOIN Einheiten ON Korrespondenz.Einheit = Einheiten.ID  LEFT OUTER JOIN Einstellungen ON Korrespondenz.Team = Einstellungen.Team",
    "sqlWhere": "",
    "sqlTail": ""
  },
