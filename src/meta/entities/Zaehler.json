{
  "entity": "Zaehler",
  "shortName": "Zaehler",
  "baseTable": "Zaehler",
  "isVirtual": false,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY Zaehler.Ablesedatum DESC",
    "sqlHead": "SELECT @Zaehler := Zaehler.ID as ID,  Zaehler.Raum,  Zaehler.Zaehlerart,  @Zaehlernummer := Zaehler.Zaehlernummer as Zaehlernummer,  @Zaehlerstand := Zaehler.Zaehlerstand as Zaehlerstand,  Zaehler.Ablesedatum,  Einheiten.Bezeichnung AS Einheit,  Objekte.Bezeichnung AS Objekt,  Zaehler.Ableser,  Zaehler.Unterschrift,  Einheiten.ID AS EinheitenID,  Objekte.ID AS ObjekteID,  Zaehler.Eichung,  Zaehler.Einheit as Masseinheit,  Zaehler.Team,  @Alterzaehlerstand := (select Zaehlerstand from Zaehler where Zaehlernummer=@Zaehlernummer and ID<@Zaehler order by ID desc limit 1 ) as Alterzaehlerstand,  @Zaehlerstand-@Alterzaehlerstand as Verbrauch",
    "sqlFrom": "FROM Zaehler  LEFT OUTER JOIN Raeume ON Zaehler.Raum = Raeume.ID  LEFT OUTER JOIN Einheiten ON Raeume.Einheit = Einheiten.ID  LEFT OUTER JOIN Objekte ON Einheiten.Objekt = Objekte.ID",
    "sqlWhere": "",
    "sqlTail": ""
  },
