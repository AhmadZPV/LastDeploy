{
 "entity": "Abrechnungen",
 "shortName": "Abrechnungen",
 "baseTable": "Abrechnungen",
 "isVirtual": false,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY `Bezeichnung`",
  "sqlHead": "SELECT `ID`,  `Bezeichnung`,  `Von`,  `Bis`,  @Tage := DateDiff(Bis, Von)+1 as Tage,  `Quadratmeter`,  Quadratmeter*@Tage as Gesamtquadratmetertage,  `Einheiten`,  `Miteigentumsanteile`,  `Einheiten2`,  Einheiten3,  `Quadratmeter2`,  `Quadratmeter3`,  `Wasserverbrauch`,  `Muellverbrauch`,  `Stromverbrauch`,  `Personen`,  Personen*@Tage as Gesamtpersonentage,  `Objekt`,  `Art`,  `Heizwert`,  `Waermemengenzaehler`,  `Waermeverbrauch`,  `Grundkostenanteil`,  round(100/(Waermeverbrauch/Waermemengenzaehler), 2) AS `Warmwasser_Anteil`,  `Buchfuehrung`,  `Anmerkungen`,  `Miteigentumsanteile2`,  `Miteigentumsanteile3`,  `Erledigt`,  Team",
  "sqlFrom": "FROM `Abrechnungen`",
  "sqlWhere": "",
  "sqlTail": ""
 },
