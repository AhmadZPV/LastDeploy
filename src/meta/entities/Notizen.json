  "sql": {
    "strOrderBy": "ORDER BY `Notizen`.`Titel`",
    "sqlHead": "SELECT `Notizen`.`Titel`,  `Notizen`.`Datum`,  `Notizen`.`Wiedervorlage`,  `Notizen`.`Bearbeitungsstatus`,  `Notizen`.`Zustaendigkeit`,  `Notizen`.`Notiztext`,  `Notizen`.`Adresse`,  `Notizen`.`Benutzer`,  `Notizen`.`Etikett`,  `Notizen`.`ID`,  `Notizen`.`Inventar`,  Concat(Adressen.Email, '?subject=', Replace(Notizen.Titel,' ','%20'), '&body=', Replace(Concat(Adressen.Anrede,'%0D%0A',Notizen.Notiztext),'<br>','%0D%0A')) AS `Mail`,  `Notizen`.`Objekt`,  `Notizen`.`Einheit`,  `Notizen`.`Raum`,  Notizen.Vertrag,  Notizen.Team",
    "sqlFrom": "FROM `Notizen`  LEFT OUTER JOIN `Adressen` ON `Notizen`.`Adresse` = `Adressen`.`ID`",
    "sqlWhere": "",
    "sqlTail": ""
  },
