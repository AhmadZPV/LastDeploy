{
  "entity": "Abrechnungskonten_Zeitliche_Verteilung",
  "shortName": "Abrechnungskonten_Zeitliche_Verteilung",
  "baseTable": "Abrechnungskonten",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "order by Abrechnung, Einheit , Von",
    "sqlHead": "SELECT @anfang := concat(date_format(Von,\"%Y\"),\"-01-01\") as anfang,  @ende := concat(date_format(Bis,\"%Y\"),\"-12-31\") as ende,    `ID`,  `Bezeichnung`,  `Von`,  `Bis`,        case when (abs(Datediff(Von,@anfang))>0) then abs(Datediff(Von,@anfang)) end as 'Tage vorher',  Datediff(Bis,Von)+1 as Abrechnungstage,  case when (abs(Datediff(@ende,Bis))>0) then abs(Datediff(@ende,Bis)) end as 'Tage nachher',  `Abrechnung`,  `Einheit`,  `Objekt`,  Team",
    "sqlFrom": "FROM `Abrechnungskonten`",
    "sqlWhere": "",
    "sqlTail": ""
  },
  "keys": [
    "ID"
  ],
