    "sqlHead": "SELECT Team,  Benutzername,  Name,  Email,  Erstanmeldung,  @vertragsende := if(Art=\"Vertrag\",DATE_ADD(Erstanmeldung, INTERVAL 1 YEAR),if (Art=\"Vertrag 3\",DATE_ADD(Erstanmeldung, INTERVAL 3 YEAR),\"\")) AS Vertragsende,  datediff(@vertragsende, now()) AS Restlaufzeit,  ID,  Art",
