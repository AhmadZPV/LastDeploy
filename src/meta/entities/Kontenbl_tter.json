  "baseTable": "Buchungen",
  "isVirtual": true,
  "ownerField": "Team",
  "sql": {
    "strOrderBy": "ORDER BY `Kontenrahmen`.`Nummer` ASC, `Buchungen`.`Belegnummer` DESC",
    "sqlHead": "SELECT `Buchungen`.`ID`,  `Kontenrahmen`.`Buchfuehrung`,  `Kontenrahmen`.`Klasse`,  `Kontenrahmen`.`Gruppe`,  `Kontenrahmen`.`Nummer`,  `Kontenrahmen`.`Kontobezeichnung`,  Concat(`Kontenrahmen`.`Nummer`,' ',`Kontenrahmen`.`Kontobezeichnung`) as Konto,    `Buchungen`.`Betreff`,  `Buchungen`.`Datum`,    `Buchungen`.`Belegnummer`,    if(Kontenrahmen.ID=Buchungen.Konto,`Buchungen`.`Betrag`,`Buchungen`.`Betrag`*-1) as Betrag,      Kontenrahmen.Team",
    "sqlFrom": "FROM `Kontenrahmen`  LEFT OUTER JOIN `Buchungen` ON `Kontenrahmen`.`ID` = `Buchungen`.`Konto` OR `Kontenrahmen`.`ID` = `Buchungen`.`Gegenkonto`",
    "sqlWhere": "",
    "sqlTail": ""
  },
