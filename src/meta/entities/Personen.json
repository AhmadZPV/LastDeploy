  "sqlHead": "SELECT `ID`,  \t`Abrechnungskonto`,  \t`Anzahl`,  \t`Von`,  \t`Bis`,  \t`Grund`,  @tage := datediff(`Bis`,`Von`)+1 AS Tage,  @personentage := Anzahl * @Tage as Personentage,  @durchschnitt := round(@personentage / 365,1) as Durchschnitt,  Team",
