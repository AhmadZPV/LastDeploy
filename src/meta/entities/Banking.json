{
 "entity": "Banking",
 "shortName": "Banking",
 "baseTable": "Buchungen",
 "isVirtual": true,
 "ownerField": "Team",
 "sql": {
  "strOrderBy": "ORDER BY Belegnummer DESC",
  "sqlHead": "SELECT Buchungen.ID,  Buchungen.Buchfuehrung AS Buchfuehrung,  Buchungen.Konto AS Konto,  Buchungen.Gegenkonto AS Gegenkonto,  Buchungen.Datum AS Datum,  Buchungen.Betrag AS Betrag,  Buchungen.Betreff AS Betreff,  Buchungen.Belegnummer AS Belegnummer,  Kontenrahmen.Bank AS Bank,  Kontenrahmen.BIC AS BIC,  Kontenrahmen.IBAN AS IBAN,  Kontenrahmen.Kontoinhaber AS Kontoinhaber,  Replace(CONCAT('bank://singlepayment?name=',`Kontenrahmen`.`Kontoinhaber`,'&account=',`Kontenrahmen`.`IBAN`,'&BNC=',`Kontenrahmen`.`BIC`,'&amount=',`Buchungen`.`Betrag`,'&reason=',`Buchungen`.`Betreff`), ' ', '+') AS Bezahlcode,  concat(\"BCD\", '\\n', \"001\", '\\n', \"1\", '\\n', \"SCT\", '\\n', cast(Kontenrahmen.BIC as Char(11)), '\\n', cast(Kontenrahmen.Kontoinhaber as char(70)), '\\n', cast(Kontenrahmen.IBAN as char(34)), '\\n', cast(concat(\"EUR\",Buchungen.Betrag) as char(12)), '\\n', \"    \", '\\n', space(35), '\\n', cast(Buchungen.Betreff as char(140))) AS girocode,  Buchungen.Team",
  "sqlFrom": "FROM Buchungen  INNER JOIN Kontenrahmen ON Buchungen.Gegenkonto = Kontenrahmen.ID",
  "sqlWhere": "",
  "sqlTail": ""
 },
