  "Verbrauchsanteile": {
   "entity": "Verbrauchsanteile",
   "displayName": "Verbrauchsanteile",
   "shortTableName": "Verbrauchsanteile",
   "baseTable": "Abrechnungskonten",
   "chartType": "bar",
   "rawChartType": "2DBar",
   "xmlChartType": "2d_bar",
   "category": "Bezeichnung",
   "series": [
    "QM_Anteil",
    "QM_Anteil2",
    "Einheiten_Anteil",
    "Einheiten_Anteil2",
    "Muellverbrauch_Anteil",
    "Wasserverbrauch_Anteil"
   ],
   "sql": {
    "head": "Select `Abrechnungskonten`.`ID`,  `Abrechnungskonten`.`Bezeichnung`,  `Abrechnungskonten`.`Personen`,  `Abrechnungskonten`.`Einheit`,  `Abrechnungskonten`.`Adresse`,  `Abrechnungskonten`.`Objekt`,    `Abrechnungskonten`.`Abrechnung`,  `Abrechnungen`.`Von` AS `Abrechnung_Von`,  `Abrechnungen`.`Bis` AS `Abrechnung_Bis`,  `Abrechnungen`.`Quadratmeter` AS `Gesamt_Quadratmeter`,  `Abrechnungen`.`Einheiten` AS `Gesamt_Einheiten`,  (Abrechnungskonten.Quadratmeter*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Quadratmeter*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `QM_Anteil`,  (1*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Einheiten*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `Einheiten_Anteil`,  (Abrechnungskonten.Quadratmeter2*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Quadratmeter2*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `QM_Anteil2`,  (Abrechnungskonten.Einheiten2*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Einheiten2*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `Einheiten_Anteil2`,  (Abrechnungskonten.Miteigentumsanteil*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Miteigentumsanteile*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `MEA_Anteil`,  (Abrechnungskonten.Wasserverbrauch*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Wasserverbrauch*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `Wasserverbrauch_Anteil`,  (Abrechnungskonten.Muellverbrauch*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Muellverbrauch*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `Muellverbrauch_Anteil`,  (Abrechnungskonten.Personen*datediff(Abrechnungskonten.Bis,Abrechnungskonten.Von))/(Abrechnungen.Personen*datediff(Abrechnungen.Bis,Abrechnungen.Von)/100) AS `Personen_Anteil`,  (Abrechnungskonten.Warmwasserverbrauch)/(Abrechnungen.Waermemengenzaehler/100) AS `Warmwasser_Anteil`,  (Abrechnungskonten.Waermeverbrauch)/(Abrechnungen.Waermeverbrauch/100) AS `Heizung_Anteil`,    Abrechnungskonten.Team",
    "from": "FROM `Abrechnungskonten`  LEFT OUTER JOIN `Abrechnungen` ON `Abrechnungskonten`.`Abrechnung` = `Abrechnungen`.`ID`",
    "where": "",
    "tail": "",
    "orderBy": "$tstrOrderBy"
   },
