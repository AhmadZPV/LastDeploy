<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'de' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= (typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : (typeof t === 'function' ? t('app_name') : 'Erwin Property Mgmt'))) %> - <%= typeof t === 'function' ? t('app_name') : 'Erwin Property Mgmt' %></title>
  <script>document.documentElement.dataset.theme=localStorage.getItem('erwin-theme')||'dark';</script>
  <%- include('fonts') %>
  <link rel="stylesheet" href="/static/css/style.css?v=20260817-select-theme">
  <%- include('pwa') %>
</head>
<body>
<%# Presentational icon set for the navigation rail, keyed by route prefix. %>
<%
  const _icon = (d) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">' + d + '</svg>';
  const NAV_ICONS = {
    '/': _icon('<path d="M4 13h7V4H4zM13 20h7v-9h-7zM4 20h7v-4H4zM13 8h7V4h-7z"/>'),
    objekte: _icon('<path d="M4 21V6l7-3v18M11 10h9v11M14 21v-4h3v4M14 13h.01M17 13h.01"/>'),
    einheiten: _icon('<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/><path d="M9 21v-7h6v7"/>'),
    adressen: _icon('<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 5.5a3 3 0 0 1 0 5.4M18 20a5.5 5.5 0 0 0-3-4.6"/>'),
    abrechnungen: _icon('<path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6M9 16h3"/>'),
    aufgaben: _icon('<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>'),
    kontobuch: _icon('<path d="M5 4h13a1 1 0 0 1 1 1v15H6a1 1 0 0 1-1-1Z"/><path d="M9 8h6M9 12h6M9 16h4"/>'),
    termine: _icon('<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16M8 14h3M8 17h2"/>'),
    buchhaltung: _icon('<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6M9 11h2M13 11h2M9 15h2M13 15v2"/>'),
    inventar: _icon('<path d="M3 8.5 12 4l9 4.5-9 4.5Z"/><path d="M3 8.5v7L12 20l9-4.5v-7M12 13v7"/>'),
    bestellungen: _icon('<circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11h10.2L20 7H6"/>'),
    berichte: _icon('<path d="M4 20V6M9 20v-8M14 20v-5M19 20V9"/><path d="M3 20h18"/>'),
    dokumente: _icon('<path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7Z"/><path d="M14 3v4h4M9 13h6M9 17h4"/>'),
    import: _icon('<path d="M12 15V3m0 0L8 7m4-4 4 4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>'),
    einstellungen: _icon('<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.4-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.4l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4Z"/>'),
    portal: _icon('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18"/>'),
    admin: _icon('<path d="M12 3 5 6v6c0 4 3 7.4 7 9 4-1.6 7-5 7-9V6Z"/><path d="m9.5 12 1.8 1.8 3.4-3.6"/>'),
    _default: _icon('<circle cx="12" cy="12" r="7"/><path d="M12 9v6M9 12h6"/>'),
  };
  const navIcon = (href) => {
    const key = String(href || '').split('?')[0].split('/').filter(Boolean)[0];
    if (!key) return NAV_ICONS['/'];
    return NAV_ICONS[key] || NAV_ICONS._default;
  };
  const _initials = (name) => String(name || '?').trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join('').toUpperCase() || '?';
%>
<div class="layout">
  <aside class="sidebar" id="sidebar">
    <a class="logo" href="/"><span class="logo-word">Erwin</span><span class="logo-sub">Property</span></a>
    <nav>
      <a href="/" class="<%= path === '/' ? 'active' : '' %>"><span class="nav-icon"><%- navIcon('/') %></span><span class="nav-label"><%= typeof t === 'function' ? t('dashboard') : 'Dashboard' %></span></a>
      <% for (const section of (menu?.sections || [])) { %>
        <% const sectionActive = (section.groups || []).some(group => (group.items || []).some(item => item.href && item.href !== '/' && path.startsWith(item.href))); %>
        <div class="nav-section<%= sectionActive ? ' is-open has-active' : '' %>" data-nav-section="<%= section.id %>">
          <% if (section.label) { %>
            <button class="nav-section-trigger" type="button" aria-expanded="<%= sectionActive ? 'true' : 'false' %>" aria-controls="nav-panel-<%= section.id %>" data-nav-section-trigger>
              <span><%= section.label %></span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg>
            </button>
          <% } %>
          <div class="nav-section-panel" id="nav-panel-<%= section.id %>"<%= section.label && !sectionActive ? ' hidden' : '' %>>
            <% for (const group of (section.groups || [])) { %>
              <% if (group.parentLabel && group.label) { %><div class="nav-subsection-title"><%= group.label %></div><% } %>
              <% for (const item of (group.items || [])) { %>
                <% if (!item.special && item.href) { %><a href="<%= item.href %>" class="<%= item.href !== '/' && path.startsWith(item.href) ? 'active' : '' %>"<% if (item.external) { %> target="_blank" rel="noopener noreferrer"<% } %>><span class="nav-icon"><%- navIcon(item.href) %></span><span class="nav-label"><%= item.label %></span></a><% } %>
              <% } %>
            <% } %>
          </div>
        </div>
      <% } %>
      <% if (user?.isAdmin) { %><div class="nav-section"><div class="nav-section-panel"><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>"><span class="nav-icon"><%- navIcon('/admin') %></span><span class="nav-label"><%= typeof t === 'function' ? t('administration') : 'Administration' %></span></a></div></div><% } %>
    </nav>
  </aside>
  <button class="sidebar-scrim" type="button" aria-label="<%= typeof t === 'function' ? t('nav_close') : 'Navigation schließen' %>" data-nav-close></button>
  <main class="main">
    <header class="topbar">
      <button class="menu-toggle" type="button" aria-label="<%= typeof t === 'function' ? t('nav_open') : 'Navigation öffnen' %>" aria-controls="sidebar" aria-expanded="false" data-nav-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <div class="topbar-heading">
        <h1><%= typeof tx === 'function' ? tx(typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : t('app_name'))) : pageTitle %></h1>
        <% if (user) { %><span class="topbar-sub"><%= typeof t === 'function' ? t('app_name') : 'Erwin Property Mgmt' %></span><% } %>
      </div>
      <div class="user-menu">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" title="Light / Dark mode">
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
        </button>
        <div class="lang-toggle" role="group" aria-label="<%= typeof t === 'function' ? t('language') : 'Language' %>">
          <a href="/lang/de" class="lang-btn<%= (typeof lang !== 'undefined' ? lang : 'de') === 'de' ? ' active' : '' %>" title="Deutsch">DE</a>
          <a href="/lang/en" class="lang-btn<%= (typeof lang !== 'undefined' ? lang : 'de') === 'en' ? ' active' : '' %>" title="English">EN</a>
        </div>
        <% if (user) { %>
          <span class="topbar-divider" aria-hidden="true"></span>
           <a href="/import/adressen"><%= typeof t === 'function' ? t('import') : 'Import' %></a>
           <a href="/docs/admin">Docs</a>
           <a href="/changepwd"><%= typeof t === 'function' ? t('password') : 'Passwort' %></a>
          <a href="/logout"><%= typeof t === 'function' ? t('logout') : 'Abmelden' %></a>
          <span class="user-chip">
            <span class="user-avatar" aria-hidden="true"><%= _initials(user.Name || user.Benutzername) %></span>
            <span class="user-chip-text">
              <strong><%= user.Name || user.Benutzername %></strong>
              <% if (user.Gruppe) { %><span><%= user.Gruppe %></span><% } %>
            </span>
          </span>
        <% } %>
      </div>
    </header>
    <div class="content">
      <% if (typeof notification !== 'undefined' && notification) { %>
        <% const notificationText = typeof t === 'function' ? t(notification.key, notification.params || {}) : notification.key; %>
        <div class="notification notification-<%= notification.type === 'error' ? 'error' : 'success' %>" data-notification role="<%= notification.type === 'error' ? 'alert' : 'status' %>" aria-live="polite">
          <span class="notification-icon" aria-hidden="true"><%= notification.type === 'error' ? '!' : '✓' %></span>
          <span class="notification-message"><%= notificationText %></span>
          <button class="notification-close" type="button" data-notification-close aria-label="<%= typeof t === 'function' ? t('dismiss_notification') : 'Dismiss notification' %>">×</button>
        </div>
      <% } %>
