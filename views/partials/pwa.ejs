<link rel="manifest" href="/manifest.json">
<meta name="csrf-token" content="<%= csrfToken || '' %>">
<meta name="theme-color" content="#111214">
<meta name="mobile-web-app-capable" content="yes">
<link rel="icon" type="image/svg+xml" href="/static/erwin-mark.svg?v=1">
<link rel="alternate icon" type="image/png" sizes="192x192" href="/static/icon-192.png?v=1">
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js?v=9', { scope: '/' }).then(function (registration) {
      registration.update();
    }).catch(function () {});
  });
}
</script>
