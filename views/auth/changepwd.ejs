<!DOCTYPE html>
<html lang="<%= lang %>"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('change_password') %> - <%= t('app_name') %></title>
<script>document.documentElement.dataset.theme=localStorage.getItem('erwin-theme')||'light';</script>
<link rel="stylesheet" href="/static/css/style.css?v=20260811-ui2"></head>
<body class="login-page"><main class="auth-shell"><div class="auth-card">
  <div class="auth-heading"><div class="login-brand-mark">E</div><div><h1><%= t('change_password') %></h1><p><%= t('app_name') %></p></div></div>
  <% if (errors && errors.length) { %>
    <div class="form-error"><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <form method="post" action="/changepwd">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="token" value="<%= token %>">
    <% if (!withToken) { %>
    <div class="form-group"><label><%= t('current_password') %></label>
      <input type="password" name="oldpass" required autofocus></div>
    <% } %>
    <div class="form-group"><label><%= t('new_password') %></label>
      <input type="password" name="newpass" required></div>
    <div class="form-group"><label><%= t('repeat_password') %></label>
      <input type="password" name="confirm" required></div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= t('change') %></button></div>
  </form>
  <p class="auth-footnote"><a href="/login"><%= t('back_to_login') %></a></p>
 </div></main><script src="/static/js/app.js?v=20260811-ui2"></script></body></html>
