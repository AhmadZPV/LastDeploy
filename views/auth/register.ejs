<!DOCTYPE html>
<html lang="<%= lang %>"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('registration') %> - <%= t('app_name') %></title>
<script>document.documentElement.dataset.theme=localStorage.getItem('erwin-theme')||'light';</script>
<link rel="stylesheet" href="/static/css/style.css?v=20260811-ui2"></head>
<body class="login-page"><main class="auth-shell"><div class="auth-card">
  <div class="auth-heading"><div class="login-brand-mark">E</div><div><h1><%= t('registration') %></h1><p><%= t('app_name') %></p></div></div>
  <% if (errors && errors.length) { %>
    <div class="form-error"><ul><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <form method="post" action="/register">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="captchaId" value="<%= captchaId %>">
    <div class="form-group"><label><%= t('username') %></label>
      <input type="text" name="Benutzername" required value="<%= values.Benutzername || '' %>"></div>
    <div class="form-group"><label><%= t('name') %></label>
      <input type="text" name="Name" value="<%= values.Name || '' %>"></div>
    <div class="form-group"><label><%= t('email') %></label>
      <input type="email" name="Email" required value="<%= values.Email || '' %>"></div>
    <div class="form-group"><label><%= t('password') %></label>
      <input type="password" name="Passwort" required>
      <small><%= t('password_rules') %></small></div>
    <div class="form-group"><label><%= t('repeat_password') %></label>
      <input type="password" name="confirm" required></div>
    <div class="form-group"><label><%= t('security_code') %></label>
      <input type="text" name="securitycode" autocomplete="off">
      <small><a href="/captcha/<%= captchaId %>" target="_blank"><%= t('show_code') %></a></small></div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= t('register') %></button></div>
  </form>
  <p class="auth-footnote"><a href="/login"><%= t('back_to_login') %></a></p>
 </div></main><script src="/static/js/app.js?v=20260811-ui2"></script></body></html>
