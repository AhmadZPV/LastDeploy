<%- include('../partials/layout_top', { pageTitle: (isEdit ? t('edit') : t('new')) + ': ' + tx(meta.titleSingle) }) %>
<% if (typeof error === 'string' && error) { %><div class="form-error"><%= error %></div><% } %>

<%
  const SECRET_RE = /(passwort|password|passwd|kennwort|secret|token|apikey|api_key)/i;

  function inputFor(field, val) {
    const cat = helpers.fieldCategory(module, field);
    const nm = field, val4 = (val != null && val !== '') ? val : '';
    // Credentials: never echo the stored hash back into the page. An empty
    // value is skipped by the POST handler, so the password stays unchanged.
    if (SECRET_RE.test(field)) {
      const hint = isEdit ? ' placeholder="' + t('leave_blank_unchanged') + '"' : '';
      return `<input type="password" name="${nm}" value="" autocomplete="new-password"${hint}>`;
    }
    if (cat === 'lookup') {
      const opts = lookups[field] || [];
      const cur = String(val4);
      const af = meta.autoFillFields && meta.autoFillFields[field] ? ' data-autofill-entity="' + module + '" data-autofill-field="' + field + '"' : '';
      let s = `<select name="${nm}"${af}><option value="">—</option>`;
      for (const o of opts) {
        const oval = String(o.ID);
        const lbl = o.Kurzname || o.Bezeichnung || o.Name || (o.Vorname ? (o.Vorname + ' ' + (o.Nachname||'')).trim() : '') || o.Nummer || ('#'+o.ID);
        s += `<option value="${oval}"${oval === cur ? ' selected' : ''}>${String(lbl).replace(/[<&>]/g, c => ({'<':'<','&':'&','>':'>'}[c]))}</option>`;
      }
      return s + '</select>';
    }
    if (cat === 'date') {
      const dv = helpers.inputDate(val4) || '';
      return `<input type="date" name="${nm}" value="${dv}">`;
    }
    if (cat === 'money') {
      const dv = (val4 !== '' && val4 != null) ? helpers.fmtNum(val4, 2) : '';
      return `<input type="number" step="0.01" name="${nm}" value="${dv}">`;
    }
    if (cat === 'bool') {
      const checked = (val4 === 1 || val4 === '1' || val4 === true) ? ' checked' : '';
      return `<div class="control-shell"><input type="checkbox" name="${nm}" value="1"${checked}></div>`;
    }
    if (cat === 'color') {
      const cv = val4 || '#cccccc';
      return `<input type="color" name="${nm}" value="${cv}">`;
    }
    if (cat === 'textarea' || cat === 'richtext') {
      const cls = cat === 'richtext' ? ' class="rich-text-source" data-rich-text' : '';
      return `<textarea${cls} name="${nm}" rows="6">${String(val4 == null ? '' : val4)
        .replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</textarea>`;
    }
    if (cat === 'blob') {
      const has = val4 != null && val4 !== '';
      return `<input type="file" name="${nm}">` + (has ? `<small class="muted">${t('present_replace')}</small>` : '');
    }
    // plain text
    const fid = meta.fields?.[field] || {};
    if (fid.type === 'Int') {
      const dv = (val4 !== '' && val4 != null) ? String(val4) : '';
      return `<input type="number" name="${nm}" value="${dv}">`;
    }
    const dv = String(val4 == null ? '' : val4).replace(/[&<>"]/g, c => ({'&':'&','<':'<','>':'>','"':'"'}[c]));
    return `<input type="text" name="${nm}" value="${dv}">`;
  }
%>

<form class="entity-form<%= module === 'benutzer' ? ' user-edit-form' : '' %>" method="post" action="/<%= module %><%= isEdit ? '/' + item.ID : '' %>" enctype="multipart/form-data">
  <%- include('../partials/csrf') %>
  <% const specFields = (typeof spec !== 'undefined' && spec && spec.fields && spec.fields.length) ? spec.fields : null; %>
  <% const formFields = (specFields ? spec.fields.map(f => [f.name, f.label, f.required]) : (meta.listColumns || []).map(c => [c, c, false])).filter(([name]) => name !== 'ID'); %>
  <div class="form-grid">
    <div class="form-group form-id-field" hidden>
      <label for="field-ID">ID</label>
      <input id="field-ID" type="number" name="ID" value="<%= item.ID || '' %>" <%= isEdit ? 'readonly' : '' %>>
    </div>
  <% for (const [fn, flabel, freq] of formFields) { %>
    <% const fcat = helpers.fieldCategory(module, fn); %>
    <% const wide = fcat === 'textarea' || fcat === 'richtext'; %>
    <div class="form-group<%= wide ? ' field-span-all' : '' %>">
      <label><%= tx(flabel) %><% if (freq) { %> <span class="req">*</span><% } %></label>
      <%- inputFor(fn, isEdit ? item[fn] : undefined) %>
    </div>
  <% } %></div>

  <% const listed = new Set(['ID', ...(meta.listColumns || [])]); %>
  <% const extra = Object.keys(meta.fields || {}).filter(f => !listed.has(f)); %>
  <% if (extra.length) { %>
  <details class="form-extra">
    <summary><%= t('more_fields') %> (<%= extra.length %>)</summary>
    <div class="form-grid">
    <% for (const c of extra) { %>
      <% const cat = helpers.fieldCategory(module, c); if (cat === 'blob') continue; %>
      <% const wide = cat === 'textarea' || cat === 'richtext'; %>
      <div class="form-group<%= wide ? ' field-span-all' : '' %>">
        <label><%= tx(c) %></label>
        <%- inputFor(c, isEdit ? item[c] : undefined) %>
      </div>
    <% } %>
    </div>
  </details>
  <% } %>

  <div class="form-actions">
    <button class="btn btn-primary"><%= t('save') %></button>
    <a href="/<%= module %>" class="btn btn-link"><%= t('cancel') %></a>
  </div>
</form>
<%- include('../partials/layout_bottom') %>
