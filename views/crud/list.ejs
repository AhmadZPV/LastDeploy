<%- include('../partials/layout_top', { pageTitle: typeof tx === 'function' ? tx(meta.title) : meta.title }) %>
<div class="header-actions">
  <form class="search-box" method="get">
    <input name="q" value="<%= sc.q || '' %>" placeholder="<%= t('search') %>" autocomplete="off">
    <button class="btn btn-primary"><%= t('search') %></button>
    <a href="/<%= module %>/search" class="btn btn-link"><%= t('advanced') %></a>
  </form>
  <div>
    <% if (meta.capabilities?.export !== false) { %><a href="/<%= module %>/export.csv" class="btn btn-link">CSV</a><% } %>
    <% if (meta.capabilities?.add !== false) { %><a href="/<%= module %>/new" class="btn btn-primary"><%= t('new') %></a><% } %>
  </div>
</div>
<section>
  <% if (!items || items.length === 0) { %><p class="muted"><%= t('no_entries_found') %></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>ID</th><% for (const c of (meta.listColumns || [])) { %><th><%= tx(c) %></th><% } %><% if (meta.capabilities?.view !== false || meta.capabilities?.edit !== false) { %><th><%= t('actions') %></th><% } %></tr></thead>
    <tbody><% for (const item of items) { %><tr>
      <td><%= item.ID %></td>
      <% for (const c of (meta.listColumns || [])) { %><td><%- helpers.display(module, c, item[c], locals.waehrung) %></td><% } %>
      <% if (meta.capabilities?.view !== false || meta.capabilities?.edit !== false) { %><td>
        <% if (meta.capabilities?.view !== false) { %><a href="/<%= module %>/<%= item.ID %>"><%= t('show') %></a><% } %>
        <% if (meta.capabilities?.edit !== false) { %><a href="/<%= module %>/<%= item.ID %>/edit"><%= t('edit') %></a><% } %>
      </td><% } %>
    </tr><% } %></tbody>
  </table></div>
  <% } %>
</section>
<%- include('../partials/layout_bottom') %>
