<%- include('../partials/layout_top', { pageTitle: typeof tx === 'function' ? tx(meta.title) : meta.title }) %>
<div class="header-actions">
  <form class="search-box" method="get">
    <input name="q" value="<%= sc.q || '' %>" placeholder="<%= t('search') %>" autocomplete="off">
    <button class="btn btn-primary"><%= t('search') %></button>
    <a href="/<%= module %>/search" class="btn btn-link"><%= t('advanced') %></a>
  </form>
  <div>
    <% if (meta.capabilities?.export !== false) { %><a href="/<%= module %>/export.csv" class="btn btn-link">CSV</a><% } %>
    <% if (meta.capabilities?.add !== false) { %><a href="/<%= module %>/new" class="btn btn-primary"><%= t('new') %></a><% } %>
  </div>
</div>
<section>
  <% if (!items || items.length === 0) { %>
    <div class="empty-state">
      <span class="empty-state-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
      <h3><%= t('no_entries_found') %></h3>
      <% if (meta.capabilities?.add !== false) { %><a href="/<%= module %>/new" class="btn btn-primary btn-sm"><%= t('new') %></a><% } %>
    </div>
  <% } else { %>
  <div class="table-wrap"><table>
    <% const visibleColumns = (meta.listColumns || []).filter(c => c !== 'ID'); %>
    <thead><tr><% for (const c of visibleColumns) { %><th><%= tx(c) %></th><% } %><% if (meta.capabilities?.view !== false || meta.capabilities?.edit !== false) { %><th class="num-cell"><%= t('actions') %></th><% } %></tr></thead>
    <tbody><% for (const item of items) { %><tr>
      <% for (const c of visibleColumns) { %><td><%- helpers.display(module, c, item[c], locals.waehrung) %></td><% } %>
      <% if (meta.capabilities?.view !== false || meta.capabilities?.edit !== false) { %><td>
        <div class="row-actions">
        <% if (meta.capabilities?.view !== false) { %><a class="btn btn-ghost btn-sm" href="/<%= module %>/<%= item.ID %>"><%= t('show') %></a><% } %>
        <% if (meta.capabilities?.edit !== false) { %><a class="btn btn-ghost btn-sm" href="/<%= module %>/<%= item.ID %>/edit"><%= t('edit') %></a><% } %>
        </div>
      </td><% } %>
    </tr><% } %></tbody>
  </table></div>
  <% } %>
</section>
<%- include('../partials/layout_bottom') %>
