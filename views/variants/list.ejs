<%- include('../partials/layout_top', { pageTitle: title }) %>
<section class="variant-list"><div class="section-heading"><div><span class="eyebrow">Records</span><h2><%= tx(title) %></h2></div></div><div class="table-wrap"><table><thead><tr><th>ID</th><% for (const field of (meta.listColumns || []).slice(0, 12)) { %><th><%= tx(field) %></th><% } %></tr></thead>
<tbody><% for (const row of rows) { %><tr><td><%= row.ID %></td><% for (const field of (meta.listColumns || []).slice(0, 12)) { %><td><%- helpers.display(module, field, row[field]) %></td><% } %></tr><% } %></tbody></table></div></section>
<%- include('../partials/layout_bottom') %>
