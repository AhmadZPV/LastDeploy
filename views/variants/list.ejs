<%- include('../partials/layout_top', { pageTitle: title }) %>
<% const visibleColumns = (meta.listColumns || []).filter(field => field !== 'ID').slice(0, 12); %>
<section class="variant-list"><div class="section-heading"><div><span class="eyebrow">Records</span><h2><%= tx(title) %></h2></div></div><div class="table-wrap"><table><thead><tr><% for (const field of visibleColumns) { %><th><%= tx(field) %></th><% } %></tr></thead>
<tbody><% for (const row of rows) { %><tr><% for (const field of visibleColumns) { %><td><%- helpers.display(module, field, row[field]) %></td><% } %></tr><% } %></tbody></table></div></section>
<%- include('../partials/layout_bottom') %>
