  <main class="docs-shell">
    <aside class="docs-sidebar" aria-label="فهرست مستندات">
      <div class="docs-sidebar-heading"><span class="eyebrow">Doc Builder style</span><h1>راهنمای سامانه</h1></div>
      <label class="docs-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="جست‌وجوی مستندات" data-docs-search></label>
