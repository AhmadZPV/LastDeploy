# Copy to .env only when overriding the Docker Compose defaults.
DATABASE_URL="file:./dev.db"
APP_PORT=3000
SESSION_SECRET=generate-a-long-random-secret
PRODUCTION_ADMIN_PASSWORD=use-a-unique-strong-password
PRODUCTION_ADMIN_USERNAME=admin
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_TEAM=Team
SESSION_COOKIE_SECURE=false
SESSION_DIR=./data/sessions
TRUST_PROXY=0
ALLOW_PLAINTEXT_PASSWORDS=false
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
# --- Scaling (only relevant when you outgrow a single core) ---
# Native bcrypt already offloads hashing from the event loop. To use every CPU
# core, fork one worker per core. Disabled by default; keep it off with SQLite +
# file-based sessions unless you also move the DB to Postgres and sessions to Redis.
ENABLE_CLUSTER=0
WORKERS=4
# Number of libuv worker threads available to native bcrypt and fs. Raise it
# above the default (4) on multi-core hosts so concurrent logins hash in parallel.
UV_THREADPOOL_SIZE=16

# Production containers refuse to start with the placeholder SESSION_SECRET.
# One-time clean customer database preparation (PowerShell example):
# $env:PRODUCTION_ADMIN_PASSWORD="use-a-unique-strong-password"
# npm run production:prepare
# Optional: PRODUCTION_DB_PATH, PRODUCTION_ADMIN_USERNAME, PRODUCTION_ADMIN_NAME,
# PRODUCTION_ADMIN_EMAIL and PRODUCTION_TEAM.
# Apply schema changes only after reviewing Prisma's data-loss warning:
# docker compose run --rm app npx prisma db push --skip-generate
