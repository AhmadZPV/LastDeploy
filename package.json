{
  "name": "ap-emlaki",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + Prisma port of INtex Hausverwaltung (767-page PHPRunner 10.9 application)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:fixture": "node scripts/build-fixture.mjs",
    "smoke:charts": "node scripts/smoke-charts.mjs",
    "smoke:imports": "node scripts/smoke-imports.mjs",
    "test:features": "node scripts/test-features.mjs",
    "db:import": "node scripts/import-mysql-dump.js",
    "entities:build": "python scripts/extract-metadata.py \"%PHP_SOURCE%\"",
    "catalog:build": "node scripts/build-source-catalog.mjs",
    "parity": "node scripts/parity.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:schema": "docker compose run --rm app npx prisma db push --skip-generate",
    "docs:pdf": "node scripts/generate-client-pdf.mjs",
    "docs:sidebar": "node scripts/generate-sidebar-guide.mjs",
    "test": "node --test tests/run-tests.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
